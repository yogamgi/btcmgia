to; -webkit-overflow-scrolling: touch; }\n  table { border-collapse: collapse; width: 100%; font-size: 14px; }\n  th, td { border-bottom: 1px solid var(--border); padding: 6px 8px; text-align: left; vertical-align: middle; }\n  th { background: var(--surface-2); font-weight: 600; white-space: nowrap; }\n  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }\n  th.group { text-align: center; }\n  tr.selected td { background: var(--accent-2); }\n  .pill { display: inline-block; border-radius: 999px; padding: 1px 8px; font-size: 12px; font-weight: 600; }\n  .pill.ok { background: var(--ok-bg); color: var(--ok); }\n  .pill.behind { background: var(--warn-bg); color: var(--warn); }\n  .pill.none { background: var(--surface-2); color: var(--muted); }\n  .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }\n  .chip { border: 1px solid var(--border); background: var(--surface); color: var(--text); border-radius: 999px;\n    padding: 4px 12px; cursor: pointer; font: inherit; font-size: 13px; }\n  .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }\n  .bar { height: 8px; border-radius: 4px; background: var(--surface-2); overflow: hidden; min-width: 60px; }\n  .bar > i { display: block; height: 100%; background: var(--accent); }\n  .chart-box { position: relative; height: 300px; }\n  .editor td input, .editor td select, .editor td textarea { padding: 4px 6px; border-radius: 6px; min-width: 80px; }\n  .editor td textarea { min-height: 34px; }\n  .editor td.actions { white-space: nowrap; }\n  .editor th.sortable { cursor: pointer; user-select: none; }\n  .editor th.sel, .editor td.sel { width: 32px; text-align: center; }\n  .editor tr.selected td { background: var(--accent-2); }\n  .editor td input:disabled, .editor td select:disabled { opacity: .55; cursor: not-allowed; }\n  .bulkbar { gap: 8px; padding: 8px 10px; margin-bottom: 8px; border: 1px solid var(--border); border-radius: 8px; background: var(-