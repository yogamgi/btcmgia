// Stage 1 - Akademi BTC: single-file build. Generated by scripts/build.js; edit apps-script/ instead.

// ===== Logic.gs =====
/**
 * Pure logic for Stage 1 - Akademi BTC.
 *
 * Nothing in this file touches Google services (SpreadsheetApp, DriveApp, ...),
 * so it can be unit-tested with Node (see tests/logic.test.js).
 */

var FIELD_TYPES = ['text', 'textarea', 'number', 'date', 'select', 'radio', 'checkbox', 'student', 'category', 'file'];

// Fields the dashboard depends on. Dev can relabel / move them, never delete them.
var SYSTEM_FIELDS = {
  date: { type: 'date', label: 'Tanggal Pengerjaan' },
  student: { type: 'student', label: 'Nama Santri' },
  category: { type: 'category', label: 'Jenis Perangkat' },
  units: { type: 'number', label: 'Jumlah Unit Selesai' }
};

var TABLE_HEADERS = {
  Settings: ['key', 'value', 'description'],
  Categories: ['key', 'label', 'defaultTarget', 'order', 'active'],
  Students: ['id', 'name', 'nickname', 'active', 'notes'],
  FormFields: ['key', 'label', 'type', 'options', 'required', 'order', 'section', 'help', 'active'],
  Milestones: ['day', 'units'],
  Reports: ['id', 'submittedAt', 'updatedAt', 'studentName']
};

var EDITABLE_TABLES = ['Settings', 'Categories', 'Students', 'FormFields', 'Milestones'];

function toBool_(v) {
  if (typeof v === 'boolean') return v;
  var s = String(v == null ? '' : v).trim().toLowerCase();
  return s === 'true' || s === 'yes' || s === 'ya' || s === '1' || s === 'y';
}

function toNum_(v, fallback) {
  if (fallback === undefined) fallback = 0;
  if (v === '' || v == null) return fallback;
  var n = Number(String(v).replace(',', '.'));
  return isNaN(n) ? fallback : n;
}

function slugKey_(s) {
  return String(s == null ? '' : s).trim().toLowerCase()
    .replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 40);
}

function settingKey_(s) {
  return String(s == null ? '' : s).trim().replace(/[^A-Za-z0-9_]/g, '');
}

/** 'yyyy-MM-dd' -> days since epoch (UTC), or null. */
function dayNumber_(iso) {
  var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso == null ? '' : iso));
  if (!m) return null;
  var y = +m[1], mo = +m[2], d = +m[3];
  if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  return Math.floor(Date.UTC(y, mo - 1, d) / 86400000);
}

function isoFromDayNumber_(n) {
  return new Date(n * 86400000).toISOString().slice(0, 10);
}

function splitOptions_(s) {
  return String(s == null ? '' : s).split(/\r?\n|;/).map(function (o) { return o.trim(); })
    .filter(function (o) { return o; });
}

function settingsToObject_(rows) {
  var out = {};
  (rows || []).forEach(function (r) { if (r.key) out[r.key] = r.value; });
  return out;
}

function sortByOrder_(rows) {
  return rows.slice().sort(function (a, b) { return toNum_(a.order, 9999) - toNum_(b.order, 9999); });
}

function activeCategories_(categories) {
  return sortByOrder_((categories || []).filter(function (c) { return c.key && toBool_(c.active); }));
}

function activeStudents_(students) {
  return (students || []).filter(function (s) { return s.id && s.name && toBool_(s.active); });
}

function activeFields_(fields) {
  return sortByOrder_((fields || []).filter(function (f) { return f.key && toBool_(f.active); }));
}

/** Expected cumulative units on `day`, linear between milestone points (day 0 = 0 units). */
function interpolateMilestone_(milestones, day) {
  var ms = (milestones || []).map(function (m) { return { day: toNum_(m.day), units: toNum_(m.units) }; })
    .filter(function (m) { return m.day > 0; })
    .sort(function (a, b) { return a.day - b.day; });
  if (!ms.length) return null;
  if (day <= 0) return 0;
  var prev = { day: 0, units: 0 };
  for (var i = 0; i < ms.length; i++) {
    var m = ms[i];
    if (day <= m.day) {
      return prev.units + (m.units - prev.units) * (day - prev.day) / (m.day - prev.day);
    }
    prev = m;
  }
  return ms[ms.length - 1].units;
}

function studentTarget_(student, cat) {
  var v = student['target:' + cat.key];
  return (v === '' || v == null) ? toNum_(cat.defaultTarget) : toNum_(v);
}

function pct_(done, target) {
  return target > 0 ? Math.round((done / target) * 1000) / 10 : null;
}

/** Match a report's student cell to a student (by id, falling back to name for hand-typed rows). */
function findStudent_(students, value) {
  var v = String(value == null ? '' : value).trim();
  if (!v) return null;
  var lower = v.toLowerCase();
  for (var i = 0; i < students.length; i++) if (String(students[i].id) === v) return students[i];
  for (var j = 0; j < students.length; j++) if (String(students[j].name).trim().toLowerCase() === lower) return students[j];
  return null;
}

function findCategory_(categories, value) {
  var v = String(value == null ? '' : value).trim().toLowerCase();
  if (!v) return null;
  for (var i = 0; i < categories.length; i++) {
    var c = categories[i];
    if (String(c.key).toLowerCase() === v || String(c.label).trim().toLowerCase() === v) return c;
  }
  return null;
}

/**
 * Builds everything the dashboard shows.
 * input: { settings, categories, students, milestones, reports, today: 'yyyy-MM-dd' }
 */
function computeDashboard_(input) {
  var settings = input.settings || {};
  var cats = activeCategories_(input.categories);
  // Inactive students still appear if they have reports, so history is never hidden.
  var allStudents = (input.students || []).filter(function (s) { return s.id && s.name; });
  var reports = input.reports || [];
  var startDay = dayNumber_(settings.startDate);
  var todayDay = dayNumber_(input.today);
  var day = (startDay != null && todayDay != null) ? Math.max(0, todayDay - startDay + 1) : 0;
  var durationDays = toNum_(settings.durationDays, 30);
  var milestones = (input.milestones || []).map(function (m) { return { day: toNum_(m.day), units: toNum_(m.units) }; })
    .filter(function (m) { return m.day > 0; }).sort(function (a, b) { return a.day - b.day; });
  var lastMilestoneDay = milestones.length ? milestones[milestones.length - 1].day : 0;
  var seriesLen = Math.min(180, Math.max(day, durationDays, lastMilestoneDay, 1));
  var expected = interpolateMilestone_(milestones, day);

  var rowsById = {};
  var order = [];
  allStudents.forEach(function (s) {
    var r = {
      id: String(s.id), name: s.name, nickname: s.nickname || '', active: toBool_(s.active),
      done: {}, target: {}, ach: {}, totalDone: 0, totalTarget: 0, daily: []
    };
    for (var i = 0; i < seriesLen; i++) r.daily.push(0);
    cats.forEach(function (c) { r.done[c.key] = 0; r.target[c.key] = studentTarget_(s, c); r.totalTarget += r.target[c.key]; });
    rowsById[r.id] = r;
    order.push(r);
  });

  var unmatched = 0;
  var recent = [];
  reports.forEach(function (rep) {
    var s = findStudent_(allStudents, rep.student);
    var c = findCategory_(cats, rep.category);
    var units = toNum_(rep.units);
    if (!s || !c) { unmatched++; return; }
    var row = rowsById[String(s.id)];
    row.done[c.key] += units;
    row.totalDone += units;
    var d = dayNumber_(rep.date);
    if (d == null) d = dayNumber_(rep.submittedAt);
    var idx = (d == null || startDay == null) ? seriesLen - 1 : d - startDay;
    idx = Math.max(0, Math.min(seriesLen - 1, idx));
    row.daily[idx] += units;
    recent.push({ id: rep.id, date: rep.date || String(rep.submittedAt || '').slice(0, 10), submittedAt: rep.submittedAt || '',
      studentId: row.id, studentName: row.name, category: c.label, units: units });
  });

  var students = order.filter(function (r) { return r.active || r.totalDone > 0; });
  var totals = { done: {}, target: {}, totalDone: 0, totalTarget: 0, onTrack: 0, behind: 0 };
  cats.forEach(function (c) { totals.done[c.key] = 0; totals.target[c.key] = 0; });

  students.forEach(function (r) {
    cats.forEach(function (c) {
      r.ach[c.key] = pct_(r.done[c.key], r.target[c.key]);
      totals.done[c.key] += r.done[c.key];
      totals.target[c.key] += r.target[c.key];
    });
    r.pct = pct_(r.totalDone, r.totalTarget);
    r.expected = expected == null ? null : Math.round(expected * 10) / 10;
    r.status = expected == null ? 'none' : (r.totalDone >= expected ? 'on-track' : 'behind');
    if (r.status === 'on-track') totals.onTrack++;
    if (r.status === 'behind') totals.behind++;
    var cum = 0;
    r.cumulative = r.daily.map(function (u) { cum += u; return cum; });
    delete r.daily;
    totals.totalDone += r.totalDone;
    totals.totalTarget += r.totalTarget;
  });
  totals.pct = pct_(totals.totalDone, totals.totalTarget);
  totals.ach = {};
  cats.forEach(function (c) { totals.ach[c.key] = pct_(totals.done[c.key], totals.target[c.key]); });

  var plan = [];
  for (var i = 1; i <= seriesLen; i++) {
    var e = interpolateMilestone_(milestones, i);
    plan.push(e == null ? null : Math.round(e * 10) / 10);
  }

  recent.sort(function (a, b) { return String(b.submittedAt || b.date).localeCompare(String(a.submittedAt || a.date)); });

  return {
    batchName: settings.batchName || '',
    stageName: settings.stageName || '',
    title: settings.dashboardTitle || 'Dashboard Santri',
    notice: settings.dashboardNotice || '',
    showRecent: settings.showRecentReports === undefined ? true : toBool_(settings.showRecentReports),
    startDate: settings.startDate || '',
    today: input.today,
    day: day,
    durationDays: durationDays,
    expectedToday: expected == null ? null : Math.round(expected * 10) / 10,
    categories: cats.map(function (c) { return { key: c.key, label: c.label }; }),
    milestones: milestones,
    students: students,
    totals: totals,
    plan: plan,
    seriesLen: seriesLen,
    recent: recent.slice(0, 50),
    unmatchedReports: unmatched
  };
}

/**
 * Validates a guest submission against the form definition.
 * Returns { values: {key: cellValue}, files: [fieldKey], errors: [msg], studentName }.
 * File fields are only checked for presence; Code.gs saves them to Drive.
 */
function validateReport_(fields, answers, students, categories) {
  answers = answers || {};
  var values = {}, errors = [], files = [], studentName = '';
  var stud = activeStudents_(students);
  var cats = activeCategories_(categories);
  activeFields_(fields).forEach(function (f) {
    var v = answers[f.key];
    var required = toBool_(f.required);
    var label = f.label || f.key;
    if (f.type === 'file') {
      var has = v && v.data;
      if (required && !has) errors.push(label + ' wajib diisi.');
      if (has) files.push(f.key);
      return;
    }
    if (f.type === 'checkbox') {
      var arr = Array.isArray(v) ? v : (v ? [v] : []);
      var opts = splitOptions_(f.options);
      arr = arr.map(String).filter(function (x) { return opts.indexOf(x) >= 0; });
      if (required && !arr.length) errors.push(label + ' wajib diisi.');
      values[f.key] = arr.join(', ');
      return;
    }
    var s = String(v == null ? '' : v).trim();
    if (!s) {
      if (required) errors.push(label + ' wajib diisi.');
      values[f.key] = '';
      return;
    }
    switch (f.type) {
      case 'number':
        var n = Number(s.replace(',', '.'));
        if (isNaN(n) || n < 0) errors.push(label + ' harus berupa angka >= 0.');
        else values[f.key] = n;
        break;
      case 'date':
        if (dayNumber_(s) == null) errors.push(label + ' tidak valid.');
        else values[f.key] = s.slice(0, 10);
        break;
      case 'select':
      case 'radio':
        if (splitOptions_(f.options).indexOf(s) < 0) errors.push(label + ': pilihan tidak valid.');
        else values[f.key] = s;
        break;
      case 'student':
        var st = null;
        for (var i = 0; i < stud.length; i++) if (String(stud[i].id) === s) st = stud[i];
        if (!st) errors.push(label + ': santri tidak ditemukan.');
        else { values[f.key] = st.id; if (f.key === 'student') studentName = st.name; }
        break;
      case 'category':
        var ct = null;
        for (var j = 0; j < cats.length; j++) if (String(cats[j].key) === s) ct = cats[j];
        if (!ct) errors.push(label + ': kategori tidak ditemukan.');
        else values[f.key] = ct.key;
        break;
      default:
        values[f.key] = s.slice(0, 5000);
    }
  });
  return { values: values, files: files, errors: errors, studentName: studentName };
}

/**
 * Cleans a table the Dev panel sends back before it is written to the sheet.
 * ctx: { categories } (current categories, used for student target columns)
 * Returns { headers, rows }.
 */
function sanitizeTable_(name, rows, ctx) {
  rows = (rows || []).filter(function (r) { return r && typeof r === 'object'; });
  ctx = ctx || {};
  var headers = TABLE_HEADERS[name].slice();
  var out = [];
  var seen = {};
  function uniqueKey(base, fallback) {
    var k = base || fallback, n = 2, b = k;
    while (seen[k]) k = b + '_' + (n++);
    seen[k] = true;
    return k;
  }

  if (name === 'Settings') {
    rows.forEach(function (r) {
      var k = settingKey_(r.key);
      if (!k || seen[k]) return;
      seen[k] = true;
      out.push({ key: k, value: r.value == null ? '' : String(r.value), description: r.description || '' });
    });
  } else if (name === 'Categories') {
    rows.forEach(function (r, i) {
      var label = String(r.label || r.key || '').trim();
      if (!label) return;
      out.push({ key: uniqueKey(slugKey_(r.key || label), 'cat'), label: label,
        defaultTarget: toNum_(r.defaultTarget), order: i + 1, active: r.active === undefined ? true : toBool_(r.active) });
    });
    if (!out.length) throw new Error('Minimal harus ada 1 kategori.');
  } else if (name === 'Students') {
    var cats = activeCategories_(ctx.categories);
    cats.forEach(function (c) { headers.push('target:' + c.key); });
    var maxNum = 0;
    rows.forEach(function (r) { var m = /^S(\d+)$/.exec(String(r.id || '')); if (m) maxNum = Math.max(maxNum, +m[1]); });
    rows.forEach(function (r) {
      var nm = String(r.name || '').trim();
      if (!nm) return;
      var id = String(r.id || '').trim().replace(/[^A-Za-z0-9_-]/g, '');
      if (!id || seen[id]) id = 'S' + ('000' + (++maxNum)).slice(-3);
      seen[id] = true;
      var row = { id: id, name: nm, nickname: String(r.nickname || '').trim(),
        active: r.active === undefined ? true : toBool_(r.active), notes: r.notes || '' };
      cats.forEach(function (c) {
        var v = r['target:' + c.key];
        row['target:' + c.key] = (v === '' || v == null) ? '' : toNum_(v);
      });
      out.push(row);
    });
  } else if (name === 'FormFields') {
    rows.forEach(function (r) {
      var label = String(r.label || '').trim();
      var key = slugKey_(r.key || label);
      if (!key) return;
      if (SYSTEM_FIELDS[key]) {
        if (seen[key]) return;
        seen[key] = true;
      } else {
        key = uniqueKey(key, 'field');
      }
      var sys = SYSTEM_FIELDS[key];
      var type = sys ? sys.type : (FIELD_TYPES.indexOf(r.type) >= 0 ? r.type : 'text');
      out.push({ key: key, label: label || (sys ? sys.label : key), type: type,
        options: splitOptions_(r.options).join('\n'),
        required: r.required === undefined ? !!sys : toBool_(r.required),
        order: 0, section: String(r.section || '').trim(), help: r.help || '',
        // The dashboard cannot count a report without student, category and units, so those stay on.
        active: (sys && key !== 'date') || r.active === undefined ? true : toBool_(r.active) });
    });
    Object.keys(SYSTEM_FIELDS).forEach(function (k) {
      if (!seen[k]) out.push({ key: k, label: SYSTEM_FIELDS[k].label, type: SYSTEM_FIELDS[k].type, options: '',
        required: true, order: 0, section: '', help: '', active: true });
    });
    out.forEach(function (r, i) { r.order = i + 1; });
  } else if (name === 'Milestones') {
    rows.forEach(function (r) {
      var d = toNum_(r.day), u = toNum_(r.units);
      if (d > 0 && !seen[d]) { seen[d] = true; out.push({ day: d, units: Math.max(0, u) }); }
    });
    out.sort(function (a, b) { return a.day - b.day; });
  } else {
    throw new Error('Tabel tidak bisa diedit: ' + name);
  }
  return { headers: headers, rows: out };
}

/** Starting content for a brand-new batch (used for Batch 4 and when no source batch is copied). */
function defaultBatchTables_(batchName, startDate) {
  return {
    Settings: [
      { key: 'batchName', value: batchName, description: 'Nama batch yang tampil di aplikasi' },
      { key: 'stageName', value: 'Stage 1 - Akademi', description: 'Nama stage' },
      { key: 'startDate', value: startDate, description: 'Hari pertama Stage 1 (yyyy-MM-dd)' },
      { key: 'durationDays', value: '30', description: 'Lama stage (hari)' },
      { key: 'formTitle', value: 'Laporan Harian Stage 1 - Akademi BTC', description: 'Judul form' },
      { key: 'formDescription', value: 'Isi laporan setiap selesai mengerjakan unit.', description: 'Keterangan di bawah judul form' },
      { key: 'formOpen', value: 'true', description: 'true = form bisa diisi, false = form ditutup' },
      { key: 'successMessage', value: 'Terima kasih, laporan tersimpan.', description: 'Pesan setelah submit' },
      { key: 'dashboardTitle', value: 'Dashboard Santri', description: 'Judul dashboard' },
      { key: 'dashboardNotice', value: '', description: 'Pengumuman di atas dashboard (opsional)' },
      { key: 'showRecentReports', value: 'true', description: 'Tampilkan riwayat laporan di dashboard' }
    ],
    Categories: [
      { key: 'android', label: 'Android', defaultTarget: 60, order: 1, active: true },
      { key: 'iphone', label: 'iPhone', defaultTarget: 20, order: 2, active: true },
      { key: 'laptop', label: 'Laptop', defaultTarget: 20, order: 3, active: true }
    ],
    Students: [],
    FormFields: [
      { key: 'date', label: 'Tanggal Pengerjaan', type: 'date', options: '', required: true, order: 1, section: 'Data Laporan', help: '', active: true },
      { key: 'student', label: 'Nama Santri', type: 'student', options: '', required: true, order: 2, section: 'Data Laporan', help: '', active: true },
      { key: 'category', label: 'Jenis Perangkat', type: 'category', options: '', required: true, order: 3, section: 'Data Laporan', help: '', active: true },
      { key: 'units', label: 'Jumlah Unit Selesai', type: 'number', options: '', required: true, order: 4, section: 'Data Laporan', help: 'Jumlah unit yang selesai dikerjakan pada tanggal ini', active: true },
      { key: 'device_model', label: 'Merk / Tipe Perangkat', type: 'text', options: '', required: false, order: 5, section: 'Detail Pekerjaan', help: 'Contoh: Samsung A12, iPhone 11, Lenovo T480', active: true },
      { key: 'work_type', label: 'Jenis Pekerjaan', type: 'checkbox', options: 'Diagnosa\nGanti LCD\nGanti Baterai\nGanti Konektor Cas\nSoftware / Flashing\nLainnya', required: false, order: 6, section: 'Detail Pekerjaan', help: '', active: true },
      { key: 'notes', label: 'Catatan / Kendala', type: 'textarea', options: '', required: false, order: 7, section: 'Detail Pekerjaan', help: '', active: true },
      { key: 'photo', label: 'Foto Bukti', type: 'file', options: '', required: false, order: 8, section: 'Detail Pekerjaan', help: 'Opsional, maks 10 MB', active: true }
    ],
    Milestones: [
      { day: 5, units: 13 }, { day: 10, units: 25 }, { day: 15, units: 38 }, { day: 20, units: 50 },
      { day: 25, units: 63 }, { day: 30, units: 75 }, { day: 35, units: 88 }, { day: 40, units: 100 }
    ]
  };
}

// Node test hook; ignored by Apps Script.
if (typeof module !== 'undefined') {
  module.exports = {
    toBool_: toBool_, toNum_: toNum_, slugKey_: slugKey_, dayNumber_: dayNumber_, interpolateMilestone_: interpolateMilestone_,
    computeDashboard_: computeDashboard_, validateReport_: validateReport_, sanitizeTable_: sanitizeTable_,
    defaultBatchTables_: defaultBatchTables_, settingsToObject_: settingsToObject_, SYSTEM_FIELDS: SYSTEM_FIELDS
  };
}

// ===== Code.gs =====
/**
 * Stage 1 - Akademi BTC: web app entry point, Drive/Sheets storage, and the
 * functions the Guest and Dev pages call through google.script.run.
 *
 * Storage layout (inside the root folder chosen by the developer):
 *   <root>/Akademi BTC Stage 1 - Registry      list of batches
 *   <root>/Stage 1 - Akademi BTC - Batch 4/     one folder per batch
 *       ... - Data   (spreadsheet: Settings, Categories, Students, FormFields, Milestones, Reports)
 *       Uploads/     (photos attached to reports)
 * Every batch has its own spreadsheet, so a new batch never touches an older one.
 */

var APP_NAME = 'Stage 1 - Akademi BTC';
var DEFAULT_ROOT_FOLDER_NAME = 'Akademi BTC - Stage 1';
var REGISTRY_FILE_NAME = 'Akademi BTC Stage 1 - Registry';
var REGISTRY_HEADERS = ['id', 'name', 'spreadsheetId', 'folderId', 'status', 'isDefault', 'createdAt'];
var DEV_SESSION_SECONDS = 6 * 60 * 60;
var MAX_UPLOAD_BYTES = 10 * 1024 * 1024;

// ---------------------------------------------------------------- web app

function doGet(e) {
  var p = (e && e.parameter) || {};
  var page = p.mode === 'dev' ? 'Dev' : 'Index';
  if (!props_().getProperty('SETUP_DONE')) page = 'Setup';
  var t = template_(page);
  t.isOwner = page === 'Setup' && isOwner_();
  t.initialBatch = String(p.batch || '').replace(/[^A-Za-z0-9_-]/g, '');
  t.initialView = p.view === 'dashboard' ? 'dashboard' : 'form';
  return t.evaluate()
    .setTitle(APP_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// The single-file build (dist/Code.gs) defines HTML_FILES; the multi-file project uses real HTML files.
function template_(name) {
  return typeof HTML_FILES !== 'undefined'
    ? HtmlService.createTemplate(HTML_FILES[name]) : HtmlService.createTemplateFromFile(name);
}

function include(name) {
  return typeof HTML_FILES !== 'undefined'
    ? HTML_FILES[name] : HtmlService.createHtmlOutputFromFile(name).getContent();
}

/** True when the visitor is the account the web app runs as (anonymous visitors have no email). */
function isOwner_() {
  var active = Session.getActiveUser().getEmail();
  return !!active && active === Session.getEffectiveUser().getEmail();
}

// ---------------------------------------------------------------- helpers

function props_() { return PropertiesService.getScriptProperties(); }

function tz_() { return Session.getScriptTimeZone() || 'Asia/Jakarta'; }

function today_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }

function now_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd HH:mm:ss'); }

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function getRootFolder_() {
  var id = props_().getProperty('ROOT_FOLDER_ID');
  if (!id) throw new Error('Aplikasi belum di-setup. Developer perlu menjalankan setup() di editor Apps Script.');
  return DriveApp.getFolderById(id);
}

function getRegistrySheet_() {
  var id = props_().getProperty('REGISTRY_ID');
  if (!id) throw new Error('Aplikasi belum di-setup. Developer perlu menjalankan setup() di editor Apps Script.');
  var ss = SpreadsheetApp.openById(id);
  var sh = ss.getSheetByName('Batches');
  if (!sh) {
    sh = ss.insertSheet('Batches');
    sh.getRange(1, 1, 1, REGISTRY_HEADERS.length).setValues([REGISTRY_HEADERS]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function normalizeCell_(v) {
  if (v instanceof Date) {
    var hasTime = v.getHours() || v.getMinutes() || v.getSeconds();
    return Utilities.formatDate(v, tz_(), hasTime ? 'yyyy-MM-dd HH:mm:ss' : 'yyyy-MM-dd');
  }
  return v;
}

function getOrCreateSheet_(ss, name) {
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    var h = TABLE_HEADERS[name] || ['id'];
    sh.getRange(1, 1, 1, h.length).setValues([h]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/** Reads a sheet as { headers, rows: [{header: value}] } with dates as strings. */
function readTable_(ss, name) {
  var sh = getOrCreateSheet_(ss, name);
  var values = sh.getDataRange().getValues();
  var headers = (values[0] || []).map(function (h) { return String(h).trim(); });
  var rows = [];
  for (var i = 1; i < values.length; i++) {
    var r = values[i];
    if (r.every(function (c) { return c === '' || c == null; })) continue;
    var o = {};
    headers.forEach(function (h, j) { if (h) o[h] = normalizeCell_(r[j]); });
    rows.push(o);
  }
  return { headers: headers.filter(function (h) { return h; }), rows: rows };
}

/** Replaces a whole sheet. Cells are stored as plain text so dates/ids never get auto-converted. */
function writeTable_(ss, name, headers, rows) {
  var sh = getOrCreateSheet_(ss, name);
  sh.clearContents();
  var data = [headers].concat(rows.map(function (r) {
    return headers.map(function (h) { return r[h] == null ? '' : String(r[h]); });
  }));
  sh.getRange(1, 1, data.length, headers.length).setNumberFormat('@').setValues(data);
  sh.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  sh.setFrozenRows(1);
}

/** Adds any missing columns to the end of the header row (never removes, so old data is kept). */
function ensureHeaders_(sh, needed) {
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var current = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); });
  if (current.length === 1 && !current[0]) current = [];
  var missing = needed.filter(function (h) { return current.indexOf(h) < 0; });
  if (missing.length) {
    sh.getRange(1, current.length + 1, 1, missing.length).setValues([missing]).setFontWeight('bold');
    current = current.concat(missing);
  }
  sh.setFrozenRows(1);
  return current;
}

function reportHeaders_(fields) {
  return TABLE_HEADERS.Reports.concat((fields || []).map(function (f) { return f.key; }));
}

function getOrCreateSubfolder_(parent, name) {
  var it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}

// ---------------------------------------------------------------- batches

function listBatches_() {
  var sh = getRegistrySheet_();
  var values = sh.getDataRange().getValues();
  var headers = values[0].map(String);
  return values.slice(1).filter(function (r) { return r[0]; }).map(function (r) {
    var o = {};
    headers.forEach(function (h, i) { o[h] = normalizeCell_(r[i]); });
    o.id = String(o.id);
    o.isDefault = toBool_(o.isDefault);
    o.status = o.status || 'active';
    return o;
  });
}

function saveBatches_(list) {
  var sh = getRegistrySheet_();
  sh.clearContents();
  var data = [REGISTRY_HEADERS].concat(list.map(function (b) {
    return REGISTRY_HEADERS.map(function (h) { return b[h] == null ? '' : String(b[h]); });
  }));
  sh.getRange(1, 1, data.length, REGISTRY_HEADERS.length).setNumberFormat('@').setValues(data);
  sh.getRange(1, 1, 1, REGISTRY_HEADERS.length).setFontWeight('bold');
}

function resolveBatch_(batchId) {
  var list = listBatches_();
  if (!list.length) throw new Error('Belum ada batch. Developer perlu menjalankan setup().');
  if (batchId) {
    for (var i = 0; i < list.length; i++) if (list[i].id === String(batchId)) return list[i];
  }
  for (var j = 0; j < list.length; j++) if (list[j].isDefault) return list[j];
  for (var k = 0; k < list.length; k++) if (list[k].status !== 'archived') return list[k];
  return list[0];
}

function publicBatchList_() {
  return listBatches_().map(function (b) {
    return { id: b.id, name: b.name, status: b.status, isDefault: b.isDefault };
  });
}

function loadBatchData_(ss) {
  var settingsRows = readTable_(ss, 'Settings').rows;
  return {
    settingsRows: settingsRows,
    settings: settingsToObject_(settingsRows),
    categories: readTable_(ss, 'Categories').rows,
    students: readTable_(ss, 'Students').rows,
    fields: readTable_(ss, 'FormFields').rows,
    milestones: readTable_(ss, 'Milestones').rows
  };
}

/**
 * Creates a new, isolated batch: own folder, own spreadsheet, empty Reports.
 * opts: { name, startDate, sourceBatchId, copyStudents }
 */
function createBatch_(opts) {
  var name = String(opts.name || '').trim();
  if (!name) throw new Error('Nama batch wajib diisi.');
  var startDate = String(opts.startDate || today_()).slice(0, 10);
  if (dayNumber_(startDate) == null) throw new Error('Tanggal mulai tidak valid.');

  var list = listBatches_();
  var base = slugKey_(name).replace(/_/g, '-') || 'batch';
  var id = base, n = 2;
  while (list.some(function (b) { return b.id === id; })) id = base + '-' + (n++);

  var tables;
  if (opts.sourceBatchId) {
    var src = resolveBatch_(opts.sourceBatchId);
    var srcData = loadBatchData_(SpreadsheetApp.openById(src.spreadsheetId));
    tables = {
      Settings: srcData.settingsRows,
      Categories: srcData.categories,
      Students: opts.copyStudents ? srcData.students : [],
      FormFields: srcData.fields,
      Milestones: srcData.milestones
    };
  } else {
    tables = defaultBatchTables_(name, startDate);
  }
  // Batch-specific settings always come from the new batch, never from the copy source.
  tables.Settings = tables.Settings.filter(function (r) { return r.key !== 'batchName' && r.key !== 'startDate'; });
  tables.Settings.unshift(
    { key: 'batchName', value: name, description: 'Nama batch yang tampil di aplikasi' },
    { key: 'startDate', value: startDate, description: 'Hari pertama Stage 1 (yyyy-MM-dd)' });

  var root = getRootFolder_();
  var folder = root.createFolder(APP_NAME + ' - ' + name);
  var ss = SpreadsheetApp.create(APP_NAME + ' - ' + name + ' - Data');
  DriveApp.getFileById(ss.getId()).moveTo(folder);
  getOrCreateSubfolder_(folder, 'Uploads');

  var categories = sanitizeTable_('Categories', tables.Categories, {});
  writeTable_(ss, 'Settings', TABLE_HEADERS.Settings, sanitizeTable_('Settings', tables.Settings, {}).rows);
  writeTable_(ss, 'Categories', categories.headers, categories.rows);
  var students = sanitizeTable_('Students', tables.Students, { categories: categories.rows });
  writeTable_(ss, 'Students', students.headers, students.rows);
  var fields = sanitizeTable_('FormFields', tables.FormFields, {});
  writeTable_(ss, 'FormFields', fields.headers, fields.rows);
  var ms = sanitizeTable_('Milestones', tables.Milestones, {});
  writeTable_(ss, 'Milestones', ms.headers, ms.rows);
  writeTable_(ss, 'Reports', reportHeaders_(fields.rows), []);
  var first = ss.getSheetByName('Sheet1') || ss.getSheetByName('Sheet 1');
  if (first && ss.getSheets().length > 1) ss.deleteSheet(first);

  var meta = {
    id: id, name: name, spreadsheetId: ss.getId(), folderId: folder.getId(),
    status: 'active', isDefault: !list.some(function (b) { return b.isDefault; }), createdAt: now_()
  };
  list.push(meta);
  saveBatches_(list);
  return meta;
}

// ---------------------------------------------------------------- guest API

function apiGetPublic(batchId) {
  var meta = resolveBatch_(batchId);
  var data = loadBatchData_(SpreadsheetApp.openById(meta.spreadsheetId));
  var s = data.settings;
  return {
    batches: publicBatchList_(),
    batch: { id: meta.id, name: meta.name, status: meta.status },
    settings: {
      batchName: s.batchName || meta.name, stageName: s.stageName || '', formTitle: s.formTitle || APP_NAME,
      formDescription: s.formDescription || '', successMessage: s.successMessage || 'Terima kasih, laporan tersimpan.',
      formOpen: meta.status !== 'archived' && (s.formOpen === undefined ? true : toBool_(s.formOpen)),
      dashboardTitle: s.dashboardTitle || 'Dashboard Santri'
    },
    fields: activeFields_(data.fields).map(function (f) {
      return { key: f.key, label: f.label, type: f.type, options: splitOptions_(f.options),
        required: toBool_(f.required), section: f.section || '', help: f.help || '' };
    }),
    categories: activeCategories_(data.categories).map(function (c) { return { key: c.key, label: c.label }; }),
    students: activeStudents_(data.students).map(function (st) { return { id: String(st.id), name: st.name, nickname: st.nickname || '' }; })
      .sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); }),
    today: today_()
  };
}

function apiSubmitReport(batchId, answers) {
  var meta = resolveBatch_(batchId);
  if (meta.status === 'archived') throw new Error('Batch ini sudah ditutup.');
  var ss = SpreadsheetApp.openById(meta.spreadsheetId);
  var data = loadBatchData_(ss);
  if (data.settings.formOpen !== undefined && !toBool_(data.settings.formOpen)) throw new Error('Form sedang ditutup.');
  var result = validateReport_(data.fields, answers, data.students, data.categories);
  if (result.errors.length) throw new Error(result.errors.join('\n'));

  result.files.forEach(function (key) {
    result.values[key] = saveUpload_(meta, answers[key], result.studentName);
  });

  return withLock_(function () {
    var sh = getOrCreateSheet_(ss, 'Reports');
    var headers = ensureHeaders_(sh, reportHeaders_(activeFields_(data.fields)));
    var row = result.values;
    row.id = Utilities.getUuid().slice(0, 13);
    row.submittedAt = now_();
    row.updatedAt = '';
    row.studentName = result.studentName;
    var line = headers.map(function (h) { return row[h] == null ? '' : String(row[h]); });
    sh.getRange(sh.getLastRow() + 1, 1, 1, headers.length).setNumberFormat('@').setValues([line]);
    return { ok: true, id: row.id };
  });
}

function saveUpload_(meta, file, studentName) {
  if (!file || !file.data) return '';
  var bytes = Utilities.base64Decode(String(file.data));
  if (bytes.length > MAX_UPLOAD_BYTES) throw new Error('File terlalu besar (maks 10 MB).');
  var folder = getOrCreateSubfolder_(DriveApp.getFolderById(meta.folderId), 'Uploads');
  var name = Utilities.formatDate(new Date(), tz_(), 'yyyyMMdd-HHmmss') + ' ' + (studentName || '') + ' ' + String(file.name || 'upload');
  var blob = Utilities.newBlob(bytes, String(file.mimeType || 'application/octet-stream'), name.trim());
  return folder.createFile(blob).getUrl();
}

function apiGetDashboard(batchId) {
  var meta = resolveBatch_(batchId);
  var ss = SpreadsheetApp.openById(meta.spreadsheetId);
  var data = loadBatchData_(ss);
  var dash = computeDashboard_({
    settings: data.settings, categories: data.categories, students: data.students,
    milestones: data.milestones, reports: readTable_(ss, 'Reports').rows, today: today_()
  });
  dash.batch = { id: meta.id, name: meta.name, status: meta.status };
  dash.batches = publicBatchList_();
  if (!dash.batchName) dash.batchName = meta.name;
  return dash;
}

// ---------------------------------------------------------------- dev API

function hashPassword_(pw) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    ScriptApp.getScriptId() + '|' + pw, Utilities.Charset.UTF_8);
  return Utilities.base64Encode(bytes);
}

function setDevPasswordHash_(pw) {
  if (String(pw || '').length < 6) throw new Error('Password minimal 6 karakter.');
  props_().setProperty('DEV_PASSWORD_HASH', hashPassword_(String(pw)));
}

function requireDev_(token) {
  if (!token || !CacheService.getScriptCache().get('dev:' + token)) throw new Error('SESSION_EXPIRED');
}

function apiDevLogin(password) {
  var hash = props_().getProperty('DEV_PASSWORD_HASH');
  if (!hash) throw new Error('Password Dev belum dibuat. Jalankan setup() di editor Apps Script.');
  if (hashPassword_(String(password || '')) !== hash) {
    Utilities.sleep(1000);
    throw new Error('Password salah.');
  }
  var token = Utilities.getUuid();
  CacheService.getScriptCache().put('dev:' + token, '1', DEV_SESSION_SECONDS);
  return token;
}

function apiDevLogout(token) {
  if (token) CacheService.getScriptCache().remove('dev:' + token);
  return true;
}

function apiDevChangePassword(token, newPassword) {
  requireDev_(token);
  setDevPasswordHash_(newPassword);
  return true;
}

function apiDevGetAll(token, batchId) {
  requireDev_(token);
  var meta = resolveBatch_(batchId);
  var ss = SpreadsheetApp.openById(meta.spreadsheetId);
  var tables = {};
  EDITABLE_TABLES.concat(['Reports']).forEach(function (n) { tables[n] = readTable_(ss, n); });
  return {
    batches: listBatches_(),
    batch: meta,
    tables: tables,
    today: today_(),
    urls: {
      spreadsheet: ss.getUrl(),
      folder: DriveApp.getFolderById(meta.folderId).getUrl(),
      root: getRootFolder_().getUrl(),
      registry: SpreadsheetApp.openById(props_().getProperty('REGISTRY_ID')).getUrl(),
      app: ScriptApp.getService().getUrl()
    }
  };
}

function apiDevSaveTable(token, batchId, name, rows) {
  requireDev_(token);
  if (EDITABLE_TABLES.indexOf(name) < 0) throw new Error('Tabel tidak bisa diedit: ' + name);
  var meta = resolveBatch_(batchId);
  withLock_(function () {
    var ss = SpreadsheetApp.openById(meta.spreadsheetId);
    var ctx = { categories: readTable_(ss, 'Categories').rows };
    var clean = sanitizeTable_(name, rows, ctx);
    writeTable_(ss, name, clean.headers, clean.rows);
    if (name === 'Categories') {
      // Keep the student target columns in step with the categories.
      var st = sanitizeTable_('Students', readTable_(ss, 'Students').rows, { categories: clean.rows });
      writeTable_(ss, 'Students', st.headers, st.rows);
    }
    if (name === 'FormFields') ensureHeaders_(getOrCreateSheet_(ss, 'Reports'), reportHeaders_(clean.rows));
    if (name === 'Settings') {
      var s = settingsToObject_(clean.rows);
      if (s.batchName && s.batchName !== meta.name) {
        var list = listBatches_();
        list.forEach(function (b) { if (b.id === meta.id) b.name = s.batchName; });
        saveBatches_(list);
      }
    }
  });
  return apiDevGetAll(token, meta.id);
}

/** Inserts (no id) or updates (id) one report row. Dev edits skip guest validation on purpose. */
function apiDevSaveReport(token, batchId, row) {
  requireDev_(token);
  var meta = resolveBatch_(batchId);
  withLock_(function () {
    var ss = SpreadsheetApp.openById(meta.spreadsheetId);
    var fields = readTable_(ss, 'FormFields').rows;
    var students = readTable_(ss, 'Students').rows;
    var sh = getOrCreateSheet_(ss, 'Reports');
    var headers = ensureHeaders_(sh, reportHeaders_(fields));
    var st = findStudent_(students, row.student);
    if (st) row.studentName = st.name;
    var values = sh.getDataRange().getValues();
    var idCol = headers.indexOf('id');
    var rowIndex = -1;
    if (row.id) {
      for (var i = 1; i < values.length; i++) if (String(values[i][idCol]) === String(row.id)) { rowIndex = i + 1; break; }
      if (rowIndex < 0) throw new Error('Laporan tidak ditemukan: ' + row.id);
      var existing = values[rowIndex - 1];
      var merged = headers.map(function (h, j) {
        if (h === 'id' || h === 'submittedAt') return String(normalizeCell_(existing[j]));
        if (h === 'updatedAt') return now_();
        return row[h] === undefined ? String(normalizeCell_(existing[j])) : String(row[h] == null ? '' : row[h]);
      });
      sh.getRange(rowIndex, 1, 1, headers.length).setNumberFormat('@').setValues([merged]);
    } else {
      row.id = Utilities.getUuid().slice(0, 13);
      row.submittedAt = now_();
      row.updatedAt = '';
      var line = headers.map(function (h) { return row[h] == null ? '' : String(row[h]); });
      sh.getRange(sh.getLastRow() + 1, 1, 1, headers.length).setNumberFormat('@').setValues([line]);
    }
  });
  return apiDevGetAll(token, meta.id);
}

/** Deletes one report (id) or several (array of ids). */
function apiDevDeleteReport(token, batchId, ids) {
  requireDev_(token);
  var meta = resolveBatch_(batchId);
  var wanted = {};
  (Array.isArray(ids) ? ids : [ids]).forEach(function (id) { wanted[String(id)] = true; });
  withLock_(function () {
    var sh = getOrCreateSheet_(SpreadsheetApp.openById(meta.spreadsheetId), 'Reports');
    var values = sh.getDataRange().getValues();
    var idCol = values[0].map(String).indexOf('id');
    var found = 0;
    // Bottom-up so earlier row numbers stay valid while deleting.
    for (var i = values.length - 1; i >= 1; i--) {
      if (wanted[String(values[i][idCol])]) { sh.deleteRow(i + 1); found++; }
    }
    if (!found) throw new Error('Laporan tidak ditemukan.');
  });
  return apiDevGetAll(token, meta.id);
}

function apiDevCreateBatch(token, opts) {
  requireDev_(token);
  var meta = withLock_(function () { return createBatch_(opts || {}); });
  return apiDevGetAll(token, meta.id);
}

/** patch: { name?, status?: 'active'|'archived', isDefault?: true } */
function apiDevUpdateBatch(token, batchId, patch) {
  requireDev_(token);
  patch = patch || {};
  withLock_(function () {
    var list = listBatches_();
    var target = null;
    list.forEach(function (b) { if (b.id === String(batchId)) target = b; });
    if (!target) throw new Error('Batch tidak ditemukan.');
    if (patch.name && String(patch.name).trim()) target.name = String(patch.name).trim();
    if (patch.status === 'active' || patch.status === 'archived') target.status = patch.status;
    if (patch.isDefault) list.forEach(function (b) { b.isDefault = b.id === target.id; });
    saveBatches_(list);
    if (patch.name) {
      var ss = SpreadsheetApp.openById(target.spreadsheetId);
      var rows = readTable_(ss, 'Settings').rows;
      var found = false;
      rows.forEach(function (r) { if (r.key === 'batchName') { r.value = target.name; found = true; } });
      if (!found) rows.unshift({ key: 'batchName', value: target.name, description: 'Nama batch yang tampil di aplikasi' });
      writeTable_(ss, 'Settings', TABLE_HEADERS.Settings, rows);
    }
  });
  return apiDevGetAll(token, batchId);
}

function apiAppUrl() {
  return ScriptApp.getService().getUrl();
}

// ===== SetupCode.gs =====
/**
 * One-time setup. Easiest way: deploy the web app, then open it while signed in as the
 * owner account (hrd.madinah.reload@gmail.com); it shows a setup form the first time.
 *
 * Alternative from the editor: fill in SETUP below, choose `setup` in the function picker
 * and press Run. Running it again is safe: it only creates what is missing.
 */
var SETUP = {
  // Drive folder for all app data: its ID or URL. Empty = create "Akademi BTC - Stage 1" in My Drive.
  ROOT_FOLDER_ID: '',
  // Password for the Dev page (min 6 characters). Required on the first run.
  INITIAL_DEV_PASSWORD: '',
  FIRST_BATCH_NAME: 'Batch 4',
  // yyyy-MM-dd; empty = today.
  FIRST_BATCH_START: ''
};

function setup() {
  var log = runSetup_({
    rootFolder: SETUP.ROOT_FOLDER_ID, password: SETUP.INITIAL_DEV_PASSWORD,
    firstBatchName: SETUP.FIRST_BATCH_NAME, firstBatchStart: SETUP.FIRST_BATCH_START
  });
  Logger.log(log);
  return log;
}

/** Called by the first-run setup page. Only the owner account may run it. */
function apiRunSetup(opts) {
  if (!isOwner_()) throw new Error('Hanya pemilik aplikasi yang bisa menjalankan setup.');
  if (props_().getProperty('SETUP_DONE')) throw new Error('Aplikasi sudah di-setup.');
  if (String((opts && opts.password) || '').length < 6) throw new Error('Password minimal 6 karakter.');
  return withLock_(function () { return runSetup_(opts || {}); });
}

function folderIdFromInput_(s) {
  s = String(s || '').trim();
  var m = /\/folders\/([-\w]+)/.exec(s) || /[?&]id=([-\w]+)/.exec(s);
  return m ? m[1] : s;
}

/** opts: { rootFolder, password, firstBatchName, firstBatchStart } */
function runSetup_(opts) {
  var p = props_();
  var log = [];

  var wanted = folderIdFromInput_(opts.rootFolder);
  var rootId = p.getProperty('ROOT_FOLDER_ID');
  if (wanted && wanted !== rootId) {
    DriveApp.getFolderById(wanted); // throws if the folder is not accessible
    rootId = wanted;
    p.setProperty('ROOT_FOLDER_ID', rootId);
    log.push('Root folder set (new batches are created here).');
  }
  if (!rootId) {
    rootId = DriveApp.createFolder(DEFAULT_ROOT_FOLDER_NAME).getId();
    p.setProperty('ROOT_FOLDER_ID', rootId);
    log.push('Created root folder "' + DEFAULT_ROOT_FOLDER_NAME + '".');
  }
  var root = DriveApp.getFolderById(rootId);

  if (opts.password) {
    setDevPasswordHash_(opts.password);
    log.push('Dev password saved.');
  } else if (!p.getProperty('DEV_PASSWORD_HASH')) {
    throw new Error('Isi password Dev (min 6 karakter) lalu jalankan setup lagi.');
  }

  if (!p.getProperty('REGISTRY_ID')) {
    var reg = SpreadsheetApp.create(REGISTRY_FILE_NAME);
    DriveApp.getFileById(reg.getId()).moveTo(root);
    p.setProperty('REGISTRY_ID', reg.getId());
    getRegistrySheet_();
    var first = reg.getSheetByName('Sheet1') || reg.getSheetByName('Sheet 1');
    if (first && reg.getSheets().length > 1) reg.deleteSheet(first);
    log.push('Created registry spreadsheet.');
  }

  if (!listBatches_().length) {
    var meta = createBatch_({ name: opts.firstBatchName || 'Batch 4', startDate: opts.firstBatchStart || today_() });
    log.push('Created first batch "' + meta.name + '".');
  }

  p.setProperty('SETUP_DONE', 'true');
  log.push('Root folder: ' + root.getUrl());
  return log.join('\n');
}

// ===== HTML pages =====
var HTML_FILES = {
  "Dev": "<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <?!= include('Styles'); ?>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script>\n</head>\n<body>\n  <header class=\"top\">\n    <div>\n      <h1>Stage 1 - Akademi BTC · Dev</h1>\n      <div class=\"sub\" id=\"subtitle\">Panel developer</div>\n    </div>\n    <div class=\"row hidden\" id=\"topActions\">\n      <label class=\"row\"><span class=\"muted\">Batch</span><select id=\"batchSelect\" style=\"width:auto\"></select></label>\n      <a class=\"btn sm\" id=\"lnkSheet\" target=\"_blank\">Spreadsheet</a>\n      <a class=\"btn sm\" id=\"lnkFolder\" target=\"_blank\">Folder</a>\n      <a class=\"btn sm\" id=\"lnkGuest\" target=\"_blank\">Halaman Guest</a>\n      <button class=\"btn sm\" id=\"logoutBtn\">Keluar</button>\n    </div>\n  </header>\n  <main>\n    <section id=\"loginView\" class=\"card\" style=\"max-width:380px;margin:40px auto\">\n      <h2>Masuk sebagai Dev</h2>\n      <div id=\"loginMsg\"></div>\n      <form id=\"loginForm\">\n        <label class=\"field\"><span class=\"lbl\">Password</span><input type=\"password\" id=\"pw\" autocomplete=\"current-password\" required></label>\n        <button class=\"btn primary\" type=\"submit\">Masuk</button>\n      </form>\n    </section>\n\n    <section id=\"appView\" class=\"hidden\">\n      <nav class=\"tabs\" id=\"tabs\">\n        <button data-tab=\"batches\" class=\"active\">Batch</button>\n        <button data-tab=\"Settings\">Pengaturan</button>\n        <button data-tab=\"Students\">Santri</button>\n        <button data-tab=\"Categories\">Kategori &amp; Target</button>\n        <button data-tab=\"FormFields\">Form</button>\n        <button data-tab=\"Milestones\">Milestone</button>\n        <button data-tab=\"Reports\">Laporan</button>\n        <button data-tab=\"preview\">Dashboard</button>\n      </nav>\n\n      <div data-panel=\"batches\">\n        <div class=\"card\">\n          <h2>Daftar batch</h2>\n          <p class=\"muted\">Setiap batch punya folder dan spreadsheet sendiri, jadi data batch lain tidak ikut berubah.</p>\n          <div class=\"table-wrap\" id=\"batchTable\"></div>\n        </div>\n        <div class=\"card\" style=\"max-width:640px\">\n          <h2>Buat batch baru</h2>\n          <label class=\"field\"><span class=\"lbl\">Nama batch</span><input id=\"nbName\" placeholder=\"Batch 5\"></label>\n          <label class=\"field\"><span class=\"lbl\">Hari pertama Stage 1</span><input id=\"nbStart\" type=\"date\"></label>\n          <label class=\"field\"><span class=\"lbl\">Salin pengaturan dari</span>\n            <span class=\"help\">Form, kategori, target, milestone, dan pengaturan disalin. Laporan tidak pernah disalin.</span>\n            <select id=\"nbSource\"></select></label>\n          <label class=\"choice\"><input type=\"checkbox\" id=\"nbStudents\"> Salin juga daftar santri</label>\n          <div class=\"row\" style=\"margin-top:12px\"><button class=\"btn primary\" id=\"nbCreate\">Buat batch</button></div>\n        </div>\n        <div class=\"card\" style=\"max-width:640px\">\n          <h2>Password Dev</h2>\n          <div class=\"row\"><input type=\"password\" id=\"newPw\" placeholder=\"Password baru (min 6 karakter)\" style=\"max-width:320px\">\n            <button class=\"btn\" id=\"pwBtn\">Ganti password</button></div>\n        </div>\n      </div>\n\n      <div data-panel=\"Settings\" class=\"hidden\"><div class=\"card\"><h2>Pengaturan batch</h2>\n        <p class=\"muted\">Judul form, deskripsi, tanggal mulai, buka/tutup form, judul dan pengumuman dashboard. Tambah baris baru untuk catatan sendiri.</p>\n        <div id=\"ed_Settings\"></div></div></div>\n      <div data-panel=\"Students\" class=\"hidden\"><div class=\"card\"><h2>Santri</h2>\n        <p class=\"muted\">Kosongkan kolom target untuk memakai target default kategori. Santri nonaktif tidak muncul di form, tapi laporannya tetap dihitung.</p>\n        <div id=\"ed_Students\"></div></div></div>\n      <div data-panel=\"Categories\" class=\"hidden\"><div class=\"card\"><h2>Kategori perangkat &amp; target default</h2>\n        <p class=\"muted\">Kategori menjadi pilihan \"Jenis Perangkat\" di form dan kolom Done/Target/Achievement di dashboard.</p>\n        <div id=\"ed_Categories\"></div></div></div>\n      <div data-panel=\"FormFields\" class=\"hidden\"><div class=\"card\"><h2>Pertanyaan form</h2>\n        <p class=\"muted\">Kolom \"section\" mengelompokkan pertanyaan. Pilihan untuk select/radio/checkbox ditulis satu per baris.\n          Pertanyaan tanggal, nama santri, jenis perangkat, dan jumlah unit dipakai dashboard sehingga tidak bisa dihapus (label dan urutannya bisa diubah).\n          Menghapus pertanyaan tidak menghapus jawaban lama di spreadsheet.</p>\n        <div id=\"ed_FormFields\"></div></div></div>\n      <div data-panel=\"Milestones\" class=\"hidden\"><div class=\"card\" style=\"max-width:520px\"><h2>Milestone target kumulatif</h2>\n        <p class=\"muted\">Jumlah unit kumulatif yang diharapkan pada hari ke-N. Dipakai untuk status \"Sesuai target\".</p>\n        <div id=\"ed_Milestones\"></div></div></div>\n      <div data-panel=\"Reports\" class=\"hidden\"><div class=\"card\"><h2>Laporan</h2>\n        <div class=\"row\" style=\"margin-bottom:12px\">\n          <input id=\"repFilter\" placeholder=\"Cari nama / tanggal…\" style=\"max-width:280px\">\n          <span class=\"spacer\"></span>\n          <button class=\"btn danger\" id=\"repBulkDel\" disabled>Hapus terpilih</button>\n          <button class=\"btn\" id=\"repAdd\">+ Tambah laporan</button>\n        </div>\n        <div class=\"table-wrap\" id=\"reportTable\"></div></div></div>\n      <div data-panel=\"preview\" class=\"hidden\"><div id=\"dashboard\"><div class=\"loading\">Memuat…</div></div></div>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n\n  <?!= include('Shared'); ?>\n  <script>\n    var INITIAL_BATCH = '<?= initialBatch ?>';\n    var token = null, all = null, dashState = { selected: '' }, currentTab = 'batches';\n    try { token = sessionStorage.getItem('btcDevToken'); } catch (e) {}\n\n    function devCall(fn) {\n      var args = Array.prototype.slice.call(arguments, 1);\n      return call.apply(null, [fn, token].concat(args)).catch(function (e) {\n        if (String(e.message).indexOf('SESSION_EXPIRED') >= 0) { logout(); throw new Error('Sesi habis, silakan masuk lagi.'); }\n        throw e;\n      });\n    }\n\n    function showApp(on) {\n      document.getElementById('loginView').classList.toggle('hidden', on);\n      document.getElementById('appView').classList.toggle('hidden', !on);\n      document.getElementById('topActions').classList.toggle('hidden', !on);\n    }\n\n    function logout() {\n      if (token) call('apiDevLogout', token).catch(function () {});\n      token = null;\n      try { sessionStorage.removeItem('btcDevToken'); } catch (e) {}\n      showApp(false);\n    }\n\n    document.getElementById('loginForm').addEventListener('submit', function (e) {\n      e.preventDefault();\n      var msg = document.getElementById('loginMsg');\n      msg.innerHTML = '';\n      call('apiDevLogin', document.getElementById('pw').value).then(function (t) {\n        token = t;\n        try { sessionStorage.setItem('btcDevToken', t); } catch (e) {}\n        document.getElementById('pw').value = '';\n        load(INITIAL_BATCH);\n      }).catch(function (err) { msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>'; });\n    });\n    document.getElementById('logoutBtn').addEventListener('click', logout);\n\n    setTabs(document.getElementById('tabs'), function (tab) {\n      currentTab = tab;\n      if (tab === 'preview') loadPreview();\n    });\n\n    document.getElementById('batchSelect').addEventListener('change', function (e) { dashState.selected = ''; load(e.target.value); });\n\n    function load(batchId) {\n      return devCall('apiDevGetAll', batchId || '').then(apply).catch(function (e) { toast(e.message); });\n    }\n\n    function apply(data) {\n      all = data;\n      showApp(true);\n      var b = data.batch;\n      document.getElementById('subtitle').textContent = 'Batch aktif di panel: ' + b.name + (b.status === 'archived' ? ' (arsip)' : '');\n      document.getElementById('batchSelect').innerHTML = data.batches.map(function (x) {\n        return '<option value=\"' + esc(x.id) + '\"' + (x.id === b.id ? ' selected' : '') + '>' + esc(x.name) + '</option>';\n      }).join('');\n      document.getElementById('lnkSheet').href = data.urls.spreadsheet;\n      document.getElementById('lnkFolder').href = data.urls.folder;\n      document.getElementById('lnkGuest').href = data.urls.app + '?batch=' + encodeURIComponent(b.id);\n      renderBatches();\n      renderEditors();\n      renderReports();\n      if (currentTab === 'preview') loadPreview();\n    }\n\n    // ------------------------------------------------------------ batches\n    function renderBatches() {\n      var html = '<table><thead><tr><th>Nama</th><th>ID</th><th>Status</th><th>Default</th><th>Dibuat</th><th></th></tr></thead><tbody>';\n      all.batches.forEach(function (b) {\n        html += '<tr' + (b.id === all.batch.id ? ' class=\"selected\"' : '') + '><td>' + esc(b.name) + '</td><td class=\"muted\">' + esc(b.id) + '</td>' +\n          '<td>' + (b.status === 'archived' ? '<span class=\"pill none\">Arsip</span>' : '<span class=\"pill ok\">Aktif</span>') + '</td>' +\n          '<td>' + (b.isDefault ? '★' : '') + '</td><td class=\"muted\">' + esc(b.createdAt) + '</td><td class=\"actions row\">' +\n          '<button class=\"btn sm\" data-act=\"open\" data-id=\"' + esc(b.id) + '\">Kelola</button>' +\n          (b.isDefault ? '' : '<button class=\"btn sm\" data-act=\"default\" data-id=\"' + esc(b.id) + '\">Jadikan default</button>') +\n          '<button class=\"btn sm\" data-act=\"rename\" data-id=\"' + esc(b.id) + '\">Ganti nama</button>' +\n          (b.status === 'archived' ? '<button class=\"btn sm\" data-act=\"activate\" data-id=\"' + esc(b.id) + '\">Aktifkan</button>'\n            : '<button class=\"btn sm\" data-act=\"archive\" data-id=\"' + esc(b.id) + '\">Arsipkan</button>') +\n          '</td></tr>';\n      });\n      html += '</tbody></table><p class=\"muted\">Batch default tampil pertama di halaman Guest. Batch arsip masih bisa dilihat dashboardnya, tetapi form-nya ditutup.</p>';\n      var el = document.getElementById('batchTable');\n      el.innerHTML = html;\n      el.querySelectorAll('[data-act]').forEach(function (btn) {\n        btn.addEventListener('click', function () {\n          var id = btn.getAttribute('data-id'), act = btn.getAttribute('data-act');\n          if (act === 'open') return load(id);\n          var patch = {};\n          if (act === 'default') patch.isDefault = true;\n          if (act === 'archive') { if (!confirm('Arsipkan batch ini? Form akan ditutup, data tetap aman.')) return; patch.status = 'archived'; }\n          if (act === 'activate') patch.status = 'active';\n          if (act === 'rename') { var n = prompt('Nama baru batch:'); if (!n) return; patch.name = n; }\n          devCall('apiDevUpdateBatch', id, patch).then(function () { return load(all.batch.id); })\n            .then(function () { toast('Batch diperbarui.'); }).catch(function (e) { toast(e.message); });\n        });\n      });\n      document.getElementById('nbSource').innerHTML = '<option value=\"\">(Default bawaan aplikasi)</option>' + all.batches.map(function (b) {\n        return '<option value=\"' + esc(b.id) + '\"' + (b.id === all.batch.id ? ' selected' : '') + '>' + esc(b.name) + '</option>';\n      }).join('');\n      if (!document.getElementById('nbStart').value) document.getElementById('nbStart').value = all.today;\n    }\n\n    document.getElementById('nbCreate').addEventListener('click', function () {\n      var btn = this, name = document.getElementById('nbName').value.trim();\n      if (!name) return toast('Isi nama batch.');\n      btn.disabled = true; btn.textContent = 'Membuat…';\n      devCall('apiDevCreateBatch', {\n        name: name, startDate: document.getElementById('nbStart').value,\n        sourceBatchId: document.getElementById('nbSource').value, copyStudents: document.getElementById('nbStudents').checked\n      }).then(function (d) { apply(d); document.getElementById('nbName').value = ''; toast('Batch \"' + name + '\" dibuat.'); })\n        .catch(function (e) { toast(e.message); })\n        .then(function () { btn.disabled = false; btn.textContent = 'Buat batch'; });\n    });\n\n    document.getElementById('pwBtn').addEventListener('click', function () {\n      var pw = document.getElementById('newPw').value;\n      devCall('apiDevChangePassword', pw).then(function () { document.getElementById('newPw').value = ''; toast('Password diganti.'); })\n        .catch(function (e) { toast(e.message); });\n    });\n\n    // ------------------------------------------------------------ table editors\n    var FIELD_TYPES = [['text', 'Jawaban singkat'], ['textarea', 'Paragraf'], ['number', 'Angka'], ['date', 'Tanggal'], ['select', 'Dropdown'],\n      ['radio', 'Pilihan ganda'], ['checkbox', 'Kotak centang'], ['student', 'Nama santri'], ['category', 'Kategori perangkat'], ['file', 'Upload file']];\n    // Form questions the dashboard reads. Their key and type are fixed; student/category/units also stay active.\n    var SYSTEM_KEYS = ['date', 'student', 'category', 'units'];\n    var ALWAYS_ACTIVE = ['student', 'category', 'units'];\n\n    function columnsFor(name) {\n      if (name === 'Settings') return [{ key: 'key', label: 'Key' }, { key: 'value', label: 'Nilai', type: 'textarea' }, { key: 'description', label: 'Keterangan' }];\n      if (name === 'Categories') return [{ key: 'label', label: 'Nama kategori' }, { key: 'key', label: 'Key' },\n        { key: 'defaultTarget', label: 'Target default', type: 'number' }, { key: 'active', label: 'Aktif', type: 'bool' }];\n      if (name === 'Students') {\n        var cols = [{ key: 'name', label: 'Nama lengkap' }, { key: 'nickname', label: 'Panggilan' }, { key: 'active', label: 'Aktif', type: 'bool' }];\n        all.tables.Categories.rows.forEach(function (c) {\n          if (String(c.active) !== 'false') cols.push({ key: 'target:' + c.key, label: 'Target ' + c.label, type: 'number', placeholder: String(c.defaultTarget) });\n        });\n        cols.push({ key: 'notes', label: 'Catatan' }, { key: 'id', label: 'ID', title: 'Dipakai laporan untuk mengenali santri. Kosongkan untuk dibuat otomatis.' });\n        return cols;\n      }\n      if (name === 'FormFields') return [{ key: 'label', label: 'Pertanyaan' }, { key: 'key', label: 'Key' },\n        { key: 'type', label: 'Tipe', type: 'select', options: FIELD_TYPES }, { key: 'options', label: 'Pilihan (1 per baris)', type: 'textarea' },\n        { key: 'required', label: 'Wajib', type: 'bool' }, { key: 'section', label: 'Section' }, { key: 'help', label: 'Petunjuk' },\n        { key: 'active', label: 'Aktif', type: 'bool' }];\n      if (name === 'Milestones') return [{ key: 'day', label: 'Hari ke', type: 'number' }, { key: 'units', label: 'Jml unit kumulatif', type: 'number' }];\n    }\n\n    function newRowFor(name) {\n      if (name === 'Students' || name === 'Categories') return { active: true };\n      if (name === 'FormFields') return { type: 'text', active: true, required: false };\n      return {};\n    }\n\n    function renderEditors() {\n      ['Settings', 'Students', 'Categories', 'FormFields', 'Milestones'].forEach(function (name) {\n        tableEditor(document.getElementById('ed_' + name), name, columnsFor(name), all.tables[name].rows);\n      });\n    }\n\n    function isTrue(v) { return v === true || String(v).toLowerCase() === 'true'; }\n\n    /** Cells that cannot change for a row, with the reason shown on hover. */\n    function lockReason(name, col, row) {\n      if (name !== 'FormFields' || SYSTEM_KEYS.indexOf(row.key) < 0) return '';\n      if (col.key === 'key' || col.key === 'type') return 'Dipakai dashboard, tidak bisa diubah';\n      if (col.key === 'active' && ALWAYS_ACTIVE.indexOf(row.key) >= 0) return 'Dashboard butuh pertanyaan ini, jadi selalu aktif';\n      return '';\n    }\n\n    function cellInput(name, col, row) {\n      var v = row[col.key] == null ? '' : row[col.key];\n      var lock = lockReason(name, col, row);\n      var attrs = ' data-k=\"' + esc(col.key) + '\"' + (lock ? ' disabled title=\"' + esc(lock) + '\"' : (col.title ? ' title=\"' + esc(col.title) + '\"' : ''));\n      if (col.type === 'bool') return '<input type=\"checkbox\"' + attrs + (isTrue(v) || (lock && col.key === 'active') ? ' checked' : '') + '>';\n      if (col.type === 'select') {\n        return '<select' + attrs + '>' + col.options.map(function (o) {\n          return '<option value=\"' + esc(o[0]) + '\"' + (o[0] === v ? ' selected' : '') + '>' + esc(o[1]) + '</option>';\n        }).join('') + '</select>';\n      }\n      if (col.type === 'textarea') return '<textarea' + attrs + ' rows=\"1\">' + esc(v) + '</textarea>';\n      return '<input' + attrs + (col.type === 'number' ? ' type=\"number\"' : '') +\n        (col.placeholder ? ' placeholder=\"' + esc(col.placeholder) + '\"' : '') + ' value=\"' + esc(v) + '\">';\n    }\n\n    function bulkValueInput(col) {\n      if (!col) return '';\n      if (col.type === 'bool') return '<select data-bulk=\"value\"><option value=\"true\">Ya / aktif</option><option value=\"false\">Tidak / nonaktif</option></select>';\n      if (col.type === 'select') return '<select data-bulk=\"value\">' + col.options.map(function (o) { return '<option value=\"' + esc(o[0]) + '\">' + esc(o[1]) + '</option>'; }).join('') + '</select>';\n      return '<input data-bulk=\"value\"' + (col.type === 'number' ? ' type=\"number\"' : '') + ' placeholder=\"Nilai baru (kosongkan untuk menghapus isi)\">';\n    }\n\n    function compareValues(a, b, col) {\n      if (col.type === 'bool') return (isTrue(a) ? 1 : 0) - (isTrue(b) ? 1 : 0);\n      if (col.type === 'number') {\n        var na = a === '' || a == null ? -Infinity : Number(a), nb = b === '' || b == null ? -Infinity : Number(b);\n        return na - nb;\n      }\n      return String(a == null ? '' : a).localeCompare(String(b == null ? '' : b), 'id', { numeric: true, sensitivity: 'base' });\n    }\n\n    /**\n     * Editable table: every cell is an input, rows have checkboxes for bulk delete / duplicate / edit,\n     * column headers sort, and nothing is written until \"Simpan\".\n     */\n    function tableEditor(el, name, cols, rows) {\n      rows = rows.map(function (r) { return Object.assign({}, r); });\n      if (name === 'FormFields') rows.sort(function (a, b) { return Number(a.order || 0) - Number(b.order || 0); });\n      var selected = [];   // parallel to rows\n      var sort = { key: '', dir: 1 };\n      var dirty = false;\n      var bulkCol = cols[0].key;\n\n      function selCount() { return selected.filter(Boolean).length; }\n\n      function draw() {\n        while (selected.length < rows.length) selected.push(false);\n        selected.length = rows.length;\n        var n = selCount();\n        var col = cols.filter(function (c) { return c.key === bulkCol; })[0];\n        var html = '<div class=\"bulkbar row' + (n ? '' : ' muted') + '\">' +\n          '<strong>' + n + ' dipilih</strong>' +\n          '<button class=\"btn sm danger\" data-m=\"bulkdel\"' + (n ? '' : ' disabled') + '>Hapus terpilih</button>' +\n          '<button class=\"btn sm\" data-m=\"bulkdup\"' + (n ? '' : ' disabled') + '>Duplikat</button>' +\n          '<span class=\"row\">Ubah kolom <select data-bulk=\"col\" style=\"width:auto\">' + cols.map(function (c) {\n            return '<option value=\"' + esc(c.key) + '\"' + (c.key === bulkCol ? ' selected' : '') + '>' + esc(c.label) + '</option>';\n          }).join('') + '</select> menjadi ' + bulkValueInput(col) +\n          '<button class=\"btn sm\" data-m=\"bulkset\"' + (n ? '' : ' disabled') + '>Terapkan</button></span>' +\n          '</div>';\n        html += '<div class=\"table-wrap\"><table class=\"editor\"><thead><tr>' +\n          '<th class=\"sel\"><input type=\"checkbox\" data-m=\"selall\" title=\"Pilih semua\"' + (n && n === rows.length ? ' checked' : '') + '></th><th>No</th>' +\n          cols.map(function (c) {\n            var mark = sort.key === c.key ? (sort.dir > 0 ? ' ▲' : ' ▼') : '';\n            return '<th class=\"sortable\" data-sort=\"' + esc(c.key) + '\" title=\"Klik untuk mengurutkan\">' + esc(c.label) + mark + '</th>';\n          }).join('') + '<th></th></tr></thead><tbody>';\n        rows.forEach(function (r, i) {\n          var sys = name === 'FormFields' && SYSTEM_KEYS.indexOf(r.key) >= 0;\n          html += '<tr data-i=\"' + i + '\"' + (selected[i] ? ' class=\"selected\"' : '') + '>' +\n            '<td class=\"sel\"><input type=\"checkbox\" data-sel' + (selected[i] ? ' checked' : '') + '></td><td class=\"muted\">' + (i + 1) + '</td>' +\n            cols.map(function (c) { return '<td>' + cellInput(name, c, r) + '</td>'; }).join('') +\n            '<td class=\"actions\"><button class=\"btn sm\" data-m=\"up\" title=\"Naik\">↑</button><button class=\"btn sm\" data-m=\"down\" title=\"Turun\">↓</button>' +\n            (sys ? '' : '<button class=\"btn sm danger\" data-m=\"del\" title=\"Hapus\">✕</button>') + '</td></tr>';\n        });\n        if (!rows.length) html += '<tr><td colspan=\"' + (cols.length + 3) + '\" class=\"muted\">Belum ada data. Klik \"+ Tambah baris\".</td></tr>';\n        html += '</tbody></table></div><div class=\"row\" style=\"margin-top:12px\">' +\n          '<button class=\"btn\" data-m=\"add\">+ Tambah baris</button>' +\n          '<button class=\"btn\" data-m=\"addmany\">+ Tambah banyak</button>' +\n          '<span class=\"spacer\"></span>' + '<span class=\"muted' + (dirty ? '' : ' hidden') + '\" data-dirty>Ada perubahan yang belum disimpan</span>' +\n          '<button class=\"btn primary\" data-m=\"save\">Simpan</button></div>' +\n          '<div class=\"card hidden\" data-panel-many style=\"margin-top:12px\">' + manyHelp() +\n          '<textarea data-many rows=\"8\" style=\"margin:8px 0\"></textarea>' +\n          '<div class=\"row\"><button class=\"btn primary\" data-m=\"addmanygo\">Tambahkan ke tabel</button><button class=\"btn\" data-m=\"addmanyclose\">Batal</button></div></div>';\n        el.innerHTML = html;\n      }\n\n      function manyHelp() {\n        var keys = cols.filter(function (c) { return !lockReason(name, c, {}); }).map(function (c) { return c.label; });\n        if (name === 'Students') return '<strong>Tambah banyak santri</strong><p class=\"muted\">Tempel daftar nama, satu santri per baris. ' +\n          'Boleh ditambah panggilan dipisah koma, titik koma, atau tab (bisa langsung copy dari Excel/Sheets). Contoh:<br><code>Abdul Latif; Abdul</code><br><code>Alfiyan Ardiansyah</code></p>';\n        return '<strong>Tambah banyak baris</strong><p class=\"muted\">Satu baris per data, kolom dipisah titik koma atau tab, urutannya: ' + esc(keys.join(' ; ')) + '.</p>';\n      }\n\n      function collect() {\n        el.querySelectorAll('tbody tr[data-i]').forEach(function (tr) {\n          var i = Number(tr.getAttribute('data-i')), r = rows[i];\n          tr.querySelectorAll('[data-k]').forEach(function (inp) {\n            if (inp.disabled) return;\n            r[inp.getAttribute('data-k')] = inp.type === 'checkbox' ? inp.checked : inp.value;\n          });\n          var s = tr.querySelector('[data-sel]');\n          selected[i] = !!(s && s.checked);\n        });\n      }\n\n      function parseMany(text) {\n        var editable = cols.filter(function (c) { return !lockReason(name, c, {}); });\n        var order = name === 'Students' ? [cols[0], cols[1]] : editable;\n        var seen = {};\n        rows.forEach(function (r) { if (r.name) seen[String(r.name).trim().toLowerCase()] = true; });\n        var added = 0, skipped = 0;\n        text.split(/\\r?\\n/).forEach(function (line) {\n          if (!line.trim()) return;\n          var parts = line.split(/\\t|;|,(?=\\s*[^,]*$)/).map(function (p) { return p.trim(); });\n          if (name !== 'Students') parts = line.split(/\\t|;/).map(function (p) { return p.trim(); });\n          var r = newRowFor(name);\n          order.forEach(function (c, j) {\n            if (parts[j] === undefined || parts[j] === '') return;\n            r[c.key] = c.type === 'bool' ? /^(1|ya|y|yes|true|aktif)$/i.test(parts[j]) : parts[j];\n          });\n          if (name === 'Students') {\n            var k = String(r.name || '').toLowerCase();\n            if (!k || seen[k]) { skipped++; return; }\n            seen[k] = true;\n          }\n          rows.push(r); selected.push(false); added++;\n        });\n        return { added: added, skipped: skipped };\n      }\n\n      el.onchange = function (e) {\n        var t = e.target;\n        if (t.getAttribute('data-bulk') === 'col') { collect(); bulkCol = t.value; draw(); return; }\n        if (t.hasAttribute('data-sel')) {\n          collect();\n          var tr = t.closest('tr');\n          tr.classList.toggle('selected', t.checked);\n          refreshBar();\n          return;\n        }\n        if (t.getAttribute('data-m') === 'selall') {\n          collect();\n          for (var i = 0; i < rows.length; i++) selected[i] = t.checked;\n          draw();\n          return;\n        }\n        if (t.hasAttribute('data-k')) { dirty = true; el.querySelector('[data-dirty]').classList.remove('hidden'); }\n      };\n\n      function refreshBar() {\n        var n = selCount();\n        el.querySelector('.bulkbar strong').textContent = n + ' dipilih';\n        el.querySelector('.bulkbar').classList.toggle('muted', !n);\n        el.querySelectorAll('[data-m=\"bulkdel\"],[data-m=\"bulkdup\"],[data-m=\"bulkset\"]').forEach(function (b) { b.disabled = !n; });\n        var box = el.querySelector('[data-m=\"selall\"]');\n        if (box) box.checked = n > 0 && n === rows.length;\n      }\n\n      el.onclick = function (e) {\n        var th = e.target.closest('th[data-sort]');\n        if (th) {\n          collect();\n          var key = th.getAttribute('data-sort');\n          sort = { key: key, dir: sort.key === key ? -sort.dir : 1 };\n          var col = cols.filter(function (c) { return c.key === key; })[0];\n          var idx = rows.map(function (r, i) { return i; });\n          idx.sort(function (a, b) { return compareValues(rows[a][key], rows[b][key], col) * sort.dir || a - b; });\n          rows = idx.map(function (i) { return rows[i]; });\n          selected = idx.map(function (i) { return selected[i]; });\n          dirty = true;\n          draw();\n          return;\n        }\n        var b = e.target.closest('button[data-m]');\n        if (!b) return;\n        collect();\n        var m = b.getAttribute('data-m'), tr = b.closest('tr'), i = tr ? Number(tr.getAttribute('data-i')) : -1;\n        var keep = function (r, j) { return !selected[j] || (name === 'FormFields' && SYSTEM_KEYS.indexOf(r.key) >= 0); };\n        if (m === 'add') { rows.push(newRowFor(name)); selected.push(false); dirty = true; }\n        if (m === 'addmany') { el.querySelector('[data-panel-many]').classList.remove('hidden'); el.querySelector('[data-many]').focus(); return; }\n        if (m === 'addmanyclose') { el.querySelector('[data-panel-many]').classList.add('hidden'); return; }\n        if (m === 'addmanygo') {\n          var res = parseMany(el.querySelector('[data-many]').value);\n          if (res.added) dirty = true;\n          toast(res.added + ' baris ditambahkan' + (res.skipped ? ', ' + res.skipped + ' dilewati (nama kosong atau sudah ada)' : '') + '. Klik Simpan untuk menyimpan.');\n        }\n        if (m === 'del') { if (!confirm('Hapus baris ini?')) return; rows.splice(i, 1); selected.splice(i, 1); dirty = true; }\n        if (m === 'bulkdel') {\n          var n = selCount();\n          if (!confirm('Hapus ' + n + ' baris terpilih? Perubahan baru tersimpan setelah klik Simpan.')) return;\n          var keptSel = [];\n          rows = rows.filter(function (r, j) { var k = keep(r, j); if (k) keptSel.push(false); return k; });\n          selected = keptSel;\n          dirty = true;\n        }\n        if (m === 'bulkdup') {\n          var copies = rows.filter(function (r, j) { return selected[j]; }).map(function (r) {\n            var c = Object.assign({}, r);\n            delete c.id;\n            if (name === 'FormFields' || name === 'Categories') { c.key = ''; c.label = (c.label || '') + ' (salinan)'; }\n            if (name === 'Students') c.name = (c.name || '') + ' (salinan)';\n            return c;\n          });\n          rows = rows.concat(copies);\n          selected = selected.map(function () { return false; }).concat(copies.map(function () { return true; }));\n          dirty = true;\n        }\n        if (m === 'bulkset') {\n          var col = cols.filter(function (c) { return c.key === bulkCol; })[0];\n          var inp = el.querySelector('[data-bulk=\"value\"]');\n          var val = col.type === 'bool' ? inp.value === 'true' : inp.value;\n          var changed = 0;\n          rows.forEach(function (r, j) {\n            if (!selected[j] || lockReason(name, col, r)) return;\n            r[col.key] = val; changed++;\n          });\n          dirty = true;\n          toast(changed + ' baris diubah. Klik Simpan untuk menyimpan.');\n        }\n        if (m === 'up' && i > 0) { rows.splice(i - 1, 0, rows.splice(i, 1)[0]); selected.splice(i - 1, 0, selected.splice(i, 1)[0]); dirty = true; }\n        if (m === 'down' && i < rows.length - 1) { rows.splice(i + 1, 0, rows.splice(i, 1)[0]); selected.splice(i + 1, 0, selected.splice(i, 1)[0]); dirty = true; }\n        if (m === 'save') {\n          b.disabled = true; b.textContent = 'Menyimpan…';\n          devCall('apiDevSaveTable', all.batch.id, name, rows).then(function (d) { apply(d); toast('Tersimpan.'); })\n            .catch(function (err) { toast(err.message); b.disabled = false; b.textContent = 'Simpan'; });\n          return;\n        }\n        draw();\n      };\n      draw();\n    }\n\n    // ------------------------------------------------------------ reports\n    var editingReport = null;\n    var selectedReports = {};\n    function reportColumns() {\n      var fields = all.tables.FormFields.rows.slice().sort(function (a, b) { return Number(a.order || 0) - Number(b.order || 0); });\n      var keys = fields.map(function (f) { return f.key; });\n      var labels = {};\n      fields.forEach(function (f) { labels[f.key] = f.label; });\n      // Columns that exist in the sheet but are no longer in the form (old answers) still show at the end.\n      all.tables.Reports.headers.forEach(function (h) {\n        if (['id', 'submittedAt', 'updatedAt', 'studentName'].indexOf(h) < 0 && keys.indexOf(h) < 0) keys.push(h);\n      });\n      return { keys: keys, labels: labels, fields: fields };\n    }\n\n    function reportCellEditor(key, value, fields) {\n      var f = fields.filter(function (x) { return x.key === key; })[0];\n      var type = f ? f.type : 'text';\n      if (type === 'student') {\n        return '<select data-k=\"' + esc(key) + '\"><option value=\"\"></option>' + all.tables.Students.rows.map(function (s) {\n          return '<option value=\"' + esc(s.id) + '\"' + (String(s.id) === String(value) ? ' selected' : '') + '>' + esc(s.name) + '</option>';\n        }).join('') + '</select>';\n      }\n      if (type === 'category') {\n        return '<select data-k=\"' + esc(key) + '\"><option value=\"\"></option>' + all.tables.Categories.rows.map(function (c) {\n          return '<option value=\"' + esc(c.key) + '\"' + (String(c.key) === String(value) ? ' selected' : '') + '>' + esc(c.label) + '</option>';\n        }).join('') + '</select>';\n      }\n      var t = type === 'number' ? 'number' : type === 'date' ? 'date' : 'text';\n      return '<input type=\"' + t + '\" data-k=\"' + esc(key) + '\" value=\"' + esc(value) + '\">';\n    }\n\n    function displayValue(key, value, fields) {\n      var f = fields.filter(function (x) { return x.key === key; })[0];\n      if (f && f.type === 'student') { var s = all.tables.Students.rows.filter(function (x) { return String(x.id) === String(value); })[0]; return esc(s ? s.name : value); }\n      if (f && f.type === 'category') { var c = all.tables.Categories.rows.filter(function (x) { return String(x.key) === String(value); })[0]; return esc(c ? c.label : value); }\n      if (/^https:\\/\\//.test(String(value))) return '<a href=\"' + esc(value) + '\" target=\"_blank\">Buka</a>';\n      return esc(value);\n    }\n\n    function renderReports() {\n      var cols = reportColumns();\n      var q = document.getElementById('repFilter').value.trim().toLowerCase();\n      var rows = all.tables.Reports.rows.slice().reverse();\n      if (editingReport === 'new') rows.unshift({ id: '' });\n      if (q) rows = rows.filter(function (r) { return !r.id || JSON.stringify(r).toLowerCase().indexOf(q) >= 0; });\n      var html = '<table class=\"editor\"><thead><tr><th class=\"sel\"><input type=\"checkbox\" id=\"repSelAll\" title=\"Pilih semua yang tampil\"></th><th>Dikirim</th>' + cols.keys.map(function (k) { return '<th>' + esc(cols.labels[k] || k) + '</th>'; }).join('') +\n        '<th></th></tr></thead><tbody>';\n      rows.slice(0, 300).forEach(function (r) {\n        var editing = (editingReport === 'new' && !r.id) || (r.id && editingReport === r.id);\n        html += '<tr data-id=\"' + esc(r.id) + '\"' + (selectedReports[r.id] ? ' class=\"selected\"' : '') + '><td class=\"sel\">' +\n          (r.id ? '<input type=\"checkbox\" data-rsel' + (selectedReports[r.id] ? ' checked' : '') + '>' : '') + '</td><td class=\"muted\">' + esc(r.submittedAt || 'baru') + '</td>' + cols.keys.map(function (k) {\n          return '<td>' + (editing ? reportCellEditor(k, r[k] == null ? '' : r[k], cols.fields) : displayValue(k, r[k] == null ? '' : r[k], cols.fields)) + '</td>';\n        }).join('') + '<td class=\"actions\">' + (editing\n          ? '<button class=\"btn sm primary\" data-r=\"save\">Simpan</button><button class=\"btn sm\" data-r=\"cancel\">Batal</button>'\n          : '<button class=\"btn sm\" data-r=\"edit\">Edit</button><button class=\"btn sm danger\" data-r=\"del\">Hapus</button>') + '</td></tr>';\n      });\n      if (!rows.length) html += '<tr><td colspan=\"' + (cols.keys.length + 3) + '\" class=\"muted\">Belum ada laporan.</td></tr>';\n      html += '</tbody></table>';\n      if (rows.length > 300) html += '<p class=\"muted\">Menampilkan 300 laporan terbaru. Gunakan pencarian atau buka spreadsheet untuk data lengkap.</p>';\n      document.getElementById('reportTable').innerHTML = html;\n      updateReportBulk();\n    }\n\n    function updateReportBulk() {\n      var n = Object.keys(selectedReports).filter(function (k) { return selectedReports[k]; }).length;\n      var b = document.getElementById('repBulkDel');\n      b.disabled = !n;\n      b.textContent = n ? 'Hapus ' + n + ' terpilih' : 'Hapus terpilih';\n    }\n\n    document.getElementById('reportTable').addEventListener('change', function (e) {\n      var t = e.target;\n      if (t.id === 'repSelAll') {\n        document.querySelectorAll('#reportTable [data-rsel]').forEach(function (c) {\n          c.checked = t.checked;\n          selectedReports[c.closest('tr').getAttribute('data-id')] = t.checked;\n          c.closest('tr').classList.toggle('selected', t.checked);\n        });\n      } else if (t.hasAttribute('data-rsel')) {\n        selectedReports[t.closest('tr').getAttribute('data-id')] = t.checked;\n        t.closest('tr').classList.toggle('selected', t.checked);\n      } else return;\n      updateReportBulk();\n    });\n\n    document.getElementById('repBulkDel').addEventListener('click', function () {\n      var ids = Object.keys(selectedReports).filter(function (k) { return selectedReports[k]; });\n      if (!ids.length || !confirm('Hapus ' + ids.length + ' laporan terpilih? Tidak bisa dibatalkan.')) return;\n      var btn = this;\n      btn.disabled = true;\n      devCall('apiDevDeleteReport', all.batch.id, ids).then(function (d) { selectedReports = {}; apply(d); toast(ids.length + ' laporan dihapus.'); })\n        .catch(function (err) { toast(err.message); btn.disabled = false; });\n    });\n\n    document.getElementById('repFilter').addEventListener('input', renderReports);\n    document.getElementById('repAdd').addEventListener('click', function () { editingReport = 'new'; renderReports(); });\n    document.getElementById('reportTable').addEventListener('click', function (e) {\n      var b = e.target.closest('[data-r]');\n      if (!b) return;\n      var tr = b.closest('tr'), id = tr.getAttribute('data-id'), act = b.getAttribute('data-r');\n      if (act === 'edit') { editingReport = id; return renderReports(); }\n      if (act === 'cancel') { editingReport = null; return renderReports(); }\n      if (act === 'del') {\n        if (!confirm('Hapus laporan ini? Tidak bisa dibatalkan.')) return;\n        return devCall('apiDevDeleteReport', all.batch.id, id).then(function (d) { apply(d); toast('Laporan dihapus.'); }).catch(function (err) { toast(err.message); });\n      }\n      if (act === 'save') {\n        var row = { id: id };\n        tr.querySelectorAll('[data-k]').forEach(function (inp) { row[inp.getAttribute('data-k')] = inp.value; });\n        b.disabled = true;\n        devCall('apiDevSaveReport', all.batch.id, row).then(function (d) { editingReport = null; apply(d); toast('Laporan tersimpan.'); })\n          .catch(function (err) { toast(err.message); b.disabled = false; });\n      }\n    });\n\n    // ------------------------------------------------------------ dashboard preview\n    function loadPreview() {\n      var el = document.getElementById('dashboard');\n      el.innerHTML = '<div class=\"loading\">Memuat dashboard…</div>';\n      call('apiGetDashboard', all.batch.id).then(function (d) {\n        var extra = d.unmatchedReports ? '<div class=\"notice err\">' + d.unmatchedReports +\n          ' laporan tidak terhitung karena nama santri atau kategorinya tidak dikenali. Periksa tab Laporan.</div>' : '';\n        renderDashboard(el, d, dashState);\n        if (extra) el.insertAdjacentHTML('afterbegin', extra);\n      }).catch(function (e) { el.innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>'; });\n    }\n\n    if (token) load(INITIAL_BATCH).then(function () { if (!all) showApp(false); });\n  </script>\n</body>\n</html>\n",
  "Index": "<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <?!= include('Styles'); ?>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script>\n</head>\n<body>\n  <header class=\"top\">\n    <div>\n      <h1>Stage 1 - Akademi BTC</h1>\n      <div class=\"sub\" id=\"subtitle\">Boarding Technician Camp</div>\n    </div>\n    <label class=\"row\"><span class=\"muted\">Batch</span>\n      <select id=\"batchSelect\" style=\"width:auto\"></select>\n    </label>\n  </header>\n  <main>\n    <nav class=\"tabs\" id=\"tabs\">\n      <button data-tab=\"form\" class=\"active\">Isi Laporan</button>\n      <button data-tab=\"dashboard\">Dashboard</button>\n    </nav>\n\n    <section data-panel=\"form\">\n      <div class=\"card\" style=\"max-width:720px\">\n        <h2 id=\"formTitle\">Laporan</h2>\n        <p class=\"muted\" id=\"formDesc\"></p>\n        <div id=\"formMsg\"></div>\n        <form id=\"reportForm\" novalidate><div class=\"loading\">Memuat form…</div></form>\n      </div>\n    </section>\n\n    <section data-panel=\"dashboard\" class=\"hidden\">\n      <h2 id=\"dashTitle\" style=\"margin:0 0 12px\">Dashboard Santri</h2>\n      <div id=\"dashboard\"><div class=\"loading\">Memuat dashboard…</div></div>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n\n  <?!= include('Shared'); ?>\n  <script>\n    var INITIAL_BATCH = '<?= initialBatch ?>';\n    var pub = null, dash = null, dashState = { selected: '' }, currentTab = 'form';\n\n    setTabs(document.getElementById('tabs'), function (tab) {\n      currentTab = tab;\n      if (tab === 'dashboard') loadDashboard();\n    });\n\n    document.getElementById('batchSelect').addEventListener('change', function (e) {\n      dashState.selected = '';\n      loadPublic(e.target.value);\n    });\n\n    function loadPublic(batchId) {\n      document.getElementById('reportForm').innerHTML = '<div class=\"loading\">Memuat form…</div>';\n      call('apiGetPublic', batchId || '').then(function (p) {\n        pub = p;\n        var sel = document.getElementById('batchSelect');\n        sel.innerHTML = p.batches.map(function (b) {\n          return '<option value=\"' + esc(b.id) + '\"' + (b.id === p.batch.id ? ' selected' : '') + '>' +\n            esc(b.name) + (b.status === 'archived' ? ' (arsip)' : '') + '</option>';\n        }).join('');\n        document.getElementById('subtitle').textContent = (p.settings.stageName || 'Stage 1') + ' · ' + p.settings.batchName;\n        document.getElementById('formTitle').textContent = p.settings.formTitle;\n        document.getElementById('formDesc').textContent = p.settings.formDescription;\n        document.getElementById('dashTitle').textContent = p.settings.dashboardTitle;\n        renderForm();\n        dash = null;\n        if (currentTab === 'dashboard') loadDashboard();\n      }).catch(showFatal);\n    }\n\n    function showFatal(e) {\n      document.getElementById('reportForm').innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>';\n    }\n\n    function renderForm() {\n      var form = document.getElementById('reportForm');\n      document.getElementById('formMsg').innerHTML = '';\n      if (!pub.settings.formOpen) {\n        form.innerHTML = '<div class=\"notice info\">Form untuk batch ini sedang ditutup.</div>';\n        return;\n      }\n      var html = '', section = null;\n      pub.fields.forEach(function (f) {\n        if (f.section && f.section !== section) { section = f.section; html += '<h3>' + esc(section) + '</h3>'; }\n        html += fieldHtml(f);\n      });\n      html += '<div class=\"row\"><button class=\"btn primary\" type=\"submit\" id=\"submitBtn\">Kirim laporan</button></div>';\n      form.innerHTML = html;\n    }\n\n    function fieldHtml(f) {\n      var id = 'f_' + f.key, name = esc(f.key), req = f.required ? ' required' : '';\n      var input = '';\n      switch (f.type) {\n        case 'textarea': input = '<textarea id=\"' + id + '\" name=\"' + name + '\"' + req + '></textarea>'; break;\n        case 'number': input = '<input type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\" id=\"' + id + '\" name=\"' + name + '\"' + req + '>'; break;\n        case 'date': input = '<input type=\"date\" id=\"' + id + '\" name=\"' + name + '\" value=\"' + esc(pub.today) + '\"' + req + '>'; break;\n        case 'student':\n          input = '<select id=\"' + id + '\" name=\"' + name + '\"' + req + '><option value=\"\">— Pilih nama —</option>' +\n            pub.students.map(function (s) { return '<option value=\"' + esc(s.id) + '\">' + esc(s.name) + '</option>'; }).join('') + '</select>';\n          break;\n        case 'select':\n          input = '<select id=\"' + id + '\" name=\"' + name + '\"' + req + '><option value=\"\">— Pilih —</option>' +\n            f.options.map(function (o) { return '<option>' + esc(o) + '</option>'; }).join('') + '</select>';\n          break;\n        case 'category':\n        case 'radio':\n          var opts = f.type === 'category' ? pub.categories.map(function (c) { return { v: c.key, l: c.label }; })\n            : f.options.map(function (o) { return { v: o, l: o }; });\n          input = opts.map(function (o) {\n            return '<label class=\"choice\"><input type=\"radio\" name=\"' + name + '\" value=\"' + esc(o.v) + '\"> ' + esc(o.l) + '</label>';\n          }).join('');\n          break;\n        case 'checkbox':\n          input = f.options.map(function (o) {\n            return '<label class=\"choice\"><input type=\"checkbox\" name=\"' + name + '\" value=\"' + esc(o) + '\"> ' + esc(o) + '</label>';\n          }).join('');\n          break;\n        case 'file': input = '<input type=\"file\" id=\"' + id + '\" name=\"' + name + '\" accept=\"image/*,application/pdf\">'; break;\n        default: input = '<input type=\"text\" id=\"' + id + '\" name=\"' + name + '\"' + req + '>';\n      }\n      var wrap = (f.type === 'radio' || f.type === 'category' || f.type === 'checkbox') ? 'div' : 'label';\n      return '<' + wrap + ' class=\"field\"><span class=\"lbl\">' + esc(f.label) + (f.required ? ' <span class=\"req\">*</span>' : '') + '</span>' +\n        (f.help ? '<span class=\"help\">' + esc(f.help) + '</span>' : '') + input + '</' + wrap + '>';\n    }\n\n    function readFile(file) {\n      return new Promise(function (resolve, reject) {\n        if (file.size > 10 * 1024 * 1024) return reject(new Error('File \"' + file.name + '\" lebih dari 10 MB.'));\n        var r = new FileReader();\n        r.onload = function () { resolve({ name: file.name, mimeType: file.type, data: String(r.result).split(',')[1] }); };\n        r.onerror = function () { reject(new Error('Gagal membaca file.')); };\n        r.readAsDataURL(file);\n      });\n    }\n\n    document.getElementById('reportForm').addEventListener('submit', function (e) {\n      e.preventDefault();\n      var form = e.target, answers = {}, missing = [], pending = [];\n      pub.fields.forEach(function (f) {\n        if (f.type === 'checkbox') {\n          answers[f.key] = Array.prototype.map.call(form.querySelectorAll('input[name=\"' + f.key + '\"]:checked'), function (x) { return x.value; });\n          if (f.required && !answers[f.key].length) missing.push(f.label);\n        } else if (f.type === 'radio' || f.type === 'category') {\n          var c = form.querySelector('input[name=\"' + f.key + '\"]:checked');\n          answers[f.key] = c ? c.value : '';\n          if (f.required && !c) missing.push(f.label);\n        } else if (f.type === 'file') {\n          var file = form.elements[f.key].files[0];\n          if (f.required && !file) missing.push(f.label);\n          if (file) pending.push(readFile(file).then(function (v) { answers[f.key] = v; }));\n        } else {\n          answers[f.key] = form.elements[f.key].value;\n          if (f.required && !String(answers[f.key]).trim()) missing.push(f.label);\n        }\n      });\n      var msg = document.getElementById('formMsg');\n      if (missing.length) {\n        msg.innerHTML = '<div class=\"notice err\">Wajib diisi: ' + esc(missing.join(', ')) + '</div>';\n        msg.scrollIntoView({ behavior: 'smooth' });\n        return;\n      }\n      var btn = document.getElementById('submitBtn');\n      btn.disabled = true; btn.textContent = 'Mengirim…';\n      Promise.all(pending).then(function () {\n        return call('apiSubmitReport', pub.batch.id, answers);\n      }).then(function () {\n        msg.innerHTML = '<div class=\"notice ok\">' + esc(pub.settings.successMessage) + '</div>';\n        // Keep name and date so the same santri can quickly send another report.\n        var keep = {};\n        ['student', 'date'].forEach(function (k) { if (form.elements[k]) keep[k] = form.elements[k].value; });\n        form.reset();\n        Object.keys(keep).forEach(function (k) { form.elements[k].value = keep[k]; });\n        dash = null;\n        msg.scrollIntoView({ behavior: 'smooth' });\n      }).catch(function (err) {\n        msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>';\n        msg.scrollIntoView({ behavior: 'smooth' });\n      }).then(function () {\n        btn.disabled = false; btn.textContent = 'Kirim laporan';\n      });\n    });\n\n    function loadDashboard() {\n      var el = document.getElementById('dashboard');\n      if (!pub) return;\n      if (dash && dash.batch.id === pub.batch.id) { renderDashboard(el, dash, dashState); return; }\n      el.innerHTML = '<div class=\"loading\">Memuat dashboard…</div>';\n      call('apiGetDashboard', pub.batch.id).then(function (d) {\n        dash = d;\n        renderDashboard(el, d, dashState);\n      }).catch(function (e) { el.innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>'; });\n    }\n\n    if ('<?= initialView ?>' === 'dashboard') document.querySelector('[data-tab=\"dashboard\"]').click();\n    loadPublic(INITIAL_BATCH);\n  </script>\n</body>\n</html>\n",
  "Setup": "<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <?!= include('Styles'); ?>\n</head>\n<body>\n  <header class=\"top\"><div><h1>Stage 1 - Akademi BTC</h1><div class=\"sub\">Setup pertama</div></div></header>\n  <main>\n    <section class=\"card\" style=\"max-width:560px;margin:24px auto\">\n      <? if (!isOwner) { ?>\n        <h2>Aplikasi belum siap</h2>\n        <p class=\"muted\">Aplikasi ini belum di-setup oleh developer. Silakan coba lagi nanti.</p>\n      <? } else { ?>\n        <h2>Setup aplikasi</h2>\n        <p class=\"muted\">Halaman ini hanya muncul sekali, untuk akun pemilik. Setelah disimpan, aplikasi membuat folder data, spreadsheet registry, dan batch pertama.</p>\n        <div id=\"msg\"></div>\n        <form id=\"setupForm\">\n          <label class=\"field\"><span class=\"lbl\">Folder Google Drive untuk data</span>\n            <span class=\"help\">Tempel link folder (drive.google.com/drive/folders/…). Kosongkan untuk membuat folder baru \"Akademi BTC - Stage 1\".</span>\n            <input id=\"rootFolder\" placeholder=\"https://drive.google.com/drive/folders/...\"></label>\n          <label class=\"field\"><span class=\"lbl\">Nama batch pertama</span><input id=\"batchName\" value=\"Batch 4\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Hari pertama Stage 1</span><input id=\"batchStart\" type=\"date\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Password Dev</span><span class=\"help\">Minimal 6 karakter. Dipakai untuk masuk ke halaman Dev.</span>\n            <input id=\"pw\" type=\"password\" autocomplete=\"new-password\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Ulangi password</span><input id=\"pw2\" type=\"password\" autocomplete=\"new-password\" required></label>\n          <button class=\"btn primary\" type=\"submit\" id=\"go\">Simpan &amp; buat aplikasi</button>\n        </form>\n      <? } ?>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n  <?!= include('Shared'); ?>\n  <script>\n    var form = document.getElementById('setupForm');\n    if (form) {\n      document.getElementById('batchStart').value = new Date().toISOString().slice(0, 10);\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var msg = document.getElementById('msg'), btn = document.getElementById('go');\n        var pw = document.getElementById('pw').value;\n        if (pw.length < 6) { msg.innerHTML = '<div class=\"notice err\">Password minimal 6 karakter.</div>'; return; }\n        if (pw !== document.getElementById('pw2').value) { msg.innerHTML = '<div class=\"notice err\">Password tidak sama.</div>'; return; }\n        btn.disabled = true; btn.textContent = 'Menyiapkan…';\n        call('apiRunSetup', {\n          rootFolder: document.getElementById('rootFolder').value, password: pw,\n          firstBatchName: document.getElementById('batchName').value, firstBatchStart: document.getElementById('batchStart').value\n        }).then(function () {\n          form.classList.add('hidden');\n          return call('apiAppUrl').then(function (url) {\n            msg.innerHTML = '<div class=\"notice ok\">Setup selesai.</div><p><a class=\"btn primary\" target=\"_top\" href=\"' + esc(url) +\n              '?mode=dev\">Buka halaman Dev</a> <a class=\"btn\" target=\"_top\" href=\"' + esc(url) + '\">Buka halaman Guest</a></p>';\n          });\n        }).catch(function (err) {\n          msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>';\n          btn.disabled = false; btn.textContent = 'Simpan & buat aplikasi';\n        });\n      });\n    }\n  </script>\n</body>\n</html>\n",
  "Shared": "<script>\n  /** Promise wrapper around google.script.run. */\n  function call(fn) {\n    var args = Array.prototype.slice.call(arguments, 1);\n    return new Promise(function (resolve, reject) {\n      var r = google.script.run.withSuccessHandler(resolve).withFailureHandler(function (e) {\n        reject(e && e.message ? e : new Error(String(e)));\n      });\n      r[fn].apply(r, args);\n    });\n  }\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  }\n\n  function fmtPct(v) { return v == null ? '–' : (Math.round(v) + '%'); }\n  function fmtNum(v) { return v == null ? '–' : (Math.round(v * 10) / 10).toLocaleString('id-ID'); }\n\n  var toastTimer;\n  function toast(msg) {\n    var t = document.getElementById('toast');\n    t.textContent = msg;\n    t.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(function () { t.classList.remove('show'); }, 3000);\n  }\n\n  function setTabs(root, onChange) {\n    var buttons = root.querySelectorAll('[data-tab]');\n    buttons.forEach(function (b) {\n      b.addEventListener('click', function () {\n        buttons.forEach(function (x) { x.classList.toggle('active', x === b); });\n        document.querySelectorAll('[data-panel]').forEach(function (p) {\n          p.classList.toggle('hidden', p.getAttribute('data-panel') !== b.getAttribute('data-tab'));\n        });\n        if (onChange) onChange(b.getAttribute('data-tab'));\n      });\n    });\n  }\n\n  function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }\n\n  /**\n   * Renders the dashboard into `el`. Shared by the Guest page and the Dev preview.\n   * state.selected: student id or '' for all.\n   */\n  var charts = {};\n  function renderDashboard(el, d, state) {\n    var cats = d.categories;\n    var sel = state.selected || '';\n    var students = d.students;\n    var selStudent = students.filter(function (s) { return s.id === sel; })[0] || null;\n    var focus = selStudent ? { totalDone: selStudent.totalDone, totalTarget: selStudent.totalTarget, pct: selStudent.pct,\n      done: selStudent.done, target: selStudent.target, ach: selStudent.ach } : d.totals;\n\n    var html = '';\n    if (d.notice) html += '<div class=\"notice info\">' + esc(d.notice) + '</div>';\n    html += '<div class=\"grid kpis\" style=\"margin-bottom:16px\">';\n    html += kpi('Hari berjalan', d.day + ' / ' + d.durationDays, 'Mulai ' + esc(d.startDate || '-'));\n    html += kpi(selStudent ? 'Unit selesai' : 'Total unit selesai', fmtNum(focus.totalDone), 'Target ' + fmtNum(focus.totalTarget));\n    html += kpi('Capaian', fmtPct(focus.pct), selStudent ? esc(selStudent.name) : 'Semua santri');\n    if (d.expectedToday != null) {\n      html += selStudent\n        ? kpi('Target milestone hari ini', fmtNum(d.expectedToday), statusPill(selStudent.status))\n        : kpi('Sesuai target', d.totals.onTrack + ' / ' + students.length, d.totals.behind + ' santri di bawah target hari ini (' + fmtNum(d.expectedToday) + ' unit)');\n    }\n    cats.forEach(function (c) {\n      html += kpi(esc(c.label), fmtNum(focus.done[c.key]) + ' / ' + fmtNum(focus.target[c.key]), fmtPct(focus.ach[c.key]));\n    });\n    html += '</div>';\n\n    html += '<div class=\"card\"><div class=\"chips\">';\n    html += '<button class=\"chip' + (sel ? '' : ' active') + '\" data-student=\"\">Semua</button>';\n    students.forEach(function (s) {\n      html += '<button class=\"chip' + (sel === s.id ? ' active' : '') + '\" data-student=\"' + esc(s.id) + '\">' +\n        esc(s.nickname || s.name.split(' ')[0]) + '</button>';\n    });\n    html += '</div><div class=\"table-wrap\"><table><thead><tr><th rowspan=\"2\">No.</th><th rowspan=\"2\">Nama</th>';\n    html += '<th class=\"group\" colspan=\"' + cats.length + '\">Done</th><th class=\"group\" colspan=\"' + cats.length + '\">Target</th>';\n    html += '<th class=\"group\" colspan=\"' + cats.length + '\">Achievement</th><th class=\"group\" colspan=\"3\">Akumulasi</th><th rowspan=\"2\">Status</th></tr><tr>';\n    for (var g = 0; g < 3; g++) cats.forEach(function (c) { html += '<th class=\"num\">' + esc(c.label) + '</th>'; });\n    html += '<th class=\"num\">Prog.</th><th class=\"num\">%</th><th></th></tr></thead><tbody>';\n    students.forEach(function (s, i) {\n      html += '<tr class=\"' + (sel === s.id ? 'selected' : '') + '\"><td>' + (i + 1) + '</td><td>' + esc(s.name) + '</td>';\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtNum(s.done[c.key]) + '</td>'; });\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtNum(s.target[c.key]) + '</td>'; });\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtPct(s.ach[c.key]) + '</td>'; });\n      html += '<td class=\"num\">' + fmtNum(s.totalDone) + '</td><td class=\"num\">' + fmtPct(s.pct) + '</td>';\n      html += '<td><div class=\"bar\"><i style=\"width:' + Math.min(100, s.pct || 0) + '%\"></i></div></td>';\n      html += '<td>' + statusPill(s.status) + '</td></tr>';\n    });\n    if (!students.length) html += '<tr><td colspan=\"' + (6 + cats.length * 3) + '\" class=\"muted\">Belum ada santri.</td></tr>';\n    html += '</tbody></table></div></div>';\n\n    html += '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(320px,1fr))\">';\n    html += '<div class=\"card\"><h2>Progres kumulatif ' + (selStudent ? '– ' + esc(selStudent.name) : '(rata-rata santri)') +\n      '</h2><div class=\"chart-box\"><canvas id=\"chartLine\"></canvas></div></div>';\n    html += '<div class=\"card\"><h2>Unit selesai per santri</h2><div class=\"chart-box\"><canvas id=\"chartBar\"></canvas></div></div>';\n    html += '</div>';\n\n    html += '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(320px,1fr))\">';\n    html += '<div class=\"card\"><h2>Milestone target</h2><div class=\"table-wrap\"><table><thead><tr><th>Hari ke</th><th class=\"num\">Jml Unit</th></tr></thead><tbody>';\n    d.milestones.forEach(function (m) {\n      html += '<tr' + (d.day >= m.day ? ' class=\"selected\"' : '') + '><td>' + m.day + '</td><td class=\"num\">' + fmtNum(m.units) + '</td></tr>';\n    });\n    if (!d.milestones.length) html += '<tr><td colspan=\"2\" class=\"muted\">Belum ada milestone.</td></tr>';\n    html += '</tbody></table></div></div>';\n    if (d.showRecent) {\n      var rec = d.recent.filter(function (r) { return !sel || r.studentId === sel; }).slice(0, 15);\n      html += '<div class=\"card\"><h2>Laporan terbaru</h2><div class=\"table-wrap\"><table><thead><tr><th>Tanggal</th><th>Nama</th><th>Perangkat</th><th class=\"num\">Unit</th></tr></thead><tbody>';\n      rec.forEach(function (r) {\n        html += '<tr><td>' + esc(r.date) + '</td><td>' + esc(r.studentName) + '</td><td>' + esc(r.category) + '</td><td class=\"num\">' + fmtNum(r.units) + '</td></tr>';\n      });\n      if (!rec.length) html += '<tr><td colspan=\"4\" class=\"muted\">Belum ada laporan.</td></tr>';\n      html += '</tbody></table></div></div>';\n    }\n    html += '</div>';\n    el.innerHTML = html;\n\n    el.querySelectorAll('[data-student]').forEach(function (b) {\n      b.addEventListener('click', function () {\n        state.selected = b.getAttribute('data-student');\n        renderDashboard(el, d, state);\n      });\n    });\n    drawCharts(d, selStudent);\n  }\n\n  function kpi(label, value, hint) {\n    return '<div class=\"kpi\"><div class=\"label\">' + label + '</div><div class=\"value\">' + value + '</div><div class=\"hint\">' + (hint || '') + '</div></div>';\n  }\n\n  function statusPill(s) {\n    if (s === 'on-track') return '<span class=\"pill ok\">Sesuai target</span>';\n    if (s === 'behind') return '<span class=\"pill behind\">Di bawah target</span>';\n    return '<span class=\"pill none\">–</span>';\n  }\n\n  function drawCharts(d, selStudent) {\n    if (typeof Chart === 'undefined') return;\n    Object.keys(charts).forEach(function (k) { charts[k].destroy(); });\n    charts = {};\n    var accent = cssVar('--accent'), muted = cssVar('--muted'), border = cssVar('--border'), text = cssVar('--text');\n    Chart.defaults.color = muted;\n    Chart.defaults.borderColor = border;\n    var labels = [];\n    for (var i = 1; i <= d.seriesLen; i++) labels.push(i);\n    var actual;\n    if (selStudent) actual = selStudent.cumulative.slice();\n    else {\n      var n = d.students.length || 1;\n      actual = labels.map(function (_, idx) {\n        var sum = 0;\n        d.students.forEach(function (s) { sum += s.cumulative[idx] || 0; });\n        return Math.round(sum / n * 10) / 10;\n      });\n    }\n    // Do not draw actual progress into the future.\n    actual = actual.map(function (v, idx) { return idx < d.day ? v : null; });\n    charts.line = new Chart(document.getElementById('chartLine'), {\n      type: 'line',\n      data: { labels: labels, datasets: [\n        { label: 'Aktual', data: actual, borderColor: accent, backgroundColor: accent, pointRadius: 0, borderWidth: 2.5, spanGaps: true },\n        { label: 'Target milestone', data: d.plan, borderColor: muted, borderDash: [6, 4], pointRadius: 0, borderWidth: 1.5 }\n      ] },\n      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },\n        scales: { x: { title: { display: true, text: 'Hari ke' } }, y: { beginAtZero: true, title: { display: true, text: 'Unit' } } },\n        plugins: { legend: { labels: { color: text } } } }\n    });\n    var palette = ['#0f6e5a', '#3b82c4', '#c27c0e', '#8e5bd1', '#c2410c', '#64748b'];\n    charts.bar = new Chart(document.getElementById('chartBar'), {\n      type: 'bar',\n      data: { labels: d.students.map(function (s) { return s.nickname || s.name.split(' ')[0]; }),\n        datasets: d.categories.map(function (c, i) {\n          return { label: c.label, data: d.students.map(function (s) { return s.done[c.key]; }), backgroundColor: palette[i % palette.length], stack: 'u' };\n        }) },\n      options: { maintainAspectRatio: false, indexAxis: d.students.length > 10 ? 'y' : 'x',\n        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },\n        plugins: { legend: { labels: { color: text } } } }\n    });\n  }\n</script>\n",
  "Styles": "<style>\n  :root {\n    --bg: #f5f6f8; --surface: #ffffff; --surface-2: #eef1f5; --text: #1b2330; --muted: #5f6b7a;\n    --border: #d9dee6; --accent: #0f6e5a; --accent-2: #e6f3ef; --danger: #b42318; --danger-bg: #fdecea;\n    --warn: #9a6700; --warn-bg: #fff4d6; --ok: #137333; --ok-bg: #e6f4ea; --shadow: 0 1px 2px rgba(16,24,40,.06);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #12161c; --surface: #1a2028; --surface-2: #222a35; --text: #e6eaf0; --muted: #9aa5b4;\n      --border: #2e3846; --accent: #4cc3a3; --accent-2: #173a32; --danger: #ff8a80; --danger-bg: #3a1d1b;\n      --warn: #f2c14e; --warn-bg: #3a2f12; --ok: #7bd88f; --ok-bg: #173322; --shadow: none;\n    }\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--text);\n    font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n  a { color: var(--accent); }\n  header.top { background: var(--surface); border-bottom: 1px solid var(--border); padding: 12px 16px;\n    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }\n  header.top h1 { font-size: 18px; margin: 0; }\n  header.top .sub { color: var(--muted); font-size: 13px; }\n  main { max-width: 1200px; margin: 0 auto; padding: 16px; }\n  .tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border); margin-bottom: 16px; }\n  .tabs button { background: none; border: 0; border-bottom: 2px solid transparent; padding: 10px 14px;\n    color: var(--muted); font: inherit; cursor: pointer; }\n  .tabs button.active { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }\n  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px;\n    box-shadow: var(--shadow); margin-bottom: 16px; }\n  .card h2 { font-size: 16px; margin: 0 0 12px; }\n  .card h3 { font-size: 14px; margin: 16px 0 8px; color: var(--muted); text-transform: uppercas