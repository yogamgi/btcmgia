iv class=\"card\" data-stage-card=\"stage0\"></div>\n        <div class=\"card\" data-banner=\"stage0\"></div>\n        <nav class=\"tabs\" data-group=\"stage0\">\n          <button data-tab=\"s0form\" class=\"active\">Form</button>\n          <button data-tab=\"s0rep\">Laporan</button>\n          <button data-tab=\"s0dash\">Dashboard</button>\n        </nav>\n        <div data-group=\"stage0\" data-panel=\"s0form\"><div class=\"card\"><h2>Pertanyaan form Stage 0</h2>\n          <p class=\"muted\">Pilihan Lokasi Cabang dan Aktivitas ditulis satu per baris di kolom \"Pilihan\". Pertanyaan nama santri tidak bisa dihapus.\n            Menghapus pertanyaan tidak menghapus jawaban lama di spreadsheet.</p>\n          <div id=\"ed_S0_FormFields\"></div></div></div>\n        <div data-group=\"stage0\" data-panel=\"s0rep\" class=\"hidden\" data-reports=\"stage0\"></div>\n        <div data-group=\"stage0\" data-panel=\"s0dash\" class=\"hidden\"><div id=\"dashboard_stage0\"></div></div>\n      </div>\n\n      <div data-panel=\"stage1\" class=\"hidden\">\n        <div class=\"card\" data-stage-card=\"stage1\"></div>\n        <div class=\"card\" data-banner=\"stage1\"></div>\n        <nav class=\"tabs\" data-group=\"stage1\">\n          <button data-tab=\"Settings\" class=\"active\">Pengaturan</button>\n          <button data-tab=\"Categories\">Kategori &amp; Target</button>\n          <button data-tab=\"FormFields\">Form</button>\n          <button data-tab=\"Milestones\">Milestone</button>\n          <button data-tab=\"s1rep\">Laporan</button>\n          <button data-tab=\"s1dash\">Dashboard</button>\n        </nav>\n        <div data-group=\"stage1\" data-panel=\"Settings\"><div class=\"card\"><h2>Pengaturan Stage 1</h2>\n          <p class=\"muted\">Judul form, deskripsi, tanggal mulai, buka/tutup form, judul dan pengumuman dashboard. Tambah baris baru untuk catatan sendiri.</p>\n          <div id=\"ed_Settings\"></div></div></div>\n        <div data-group=\"stage1\" data-panel=\"Categories\" class=\"hidden\"><div class=\"card\"><h2>Kategori perangkat &amp; target default</h2>\n          <p class=\"muted\">Kategori menjadi pilihan \"Jenis Perangkat\" di form dan kolom Done/Target/Achievement di dashboard.</p>\n          <div id=\"ed_Categories\"></div></div></div>\n        <div data-group=\"stage1\" data-panel=\"FormFields\" class=\"hidden\"><div class=\"card\"><h2>Pertanyaan form Stage 1</h2>\n          <p class=\"muted\">Kolom \"section\" mengelompokkan pertanyaan. Pilihan untuk select/radio/checkbox ditulis satu per baris.\n            Pertanyaan tanggal, nama santri, dan jenis perangkat dipakai dashboard sehingga tidak bisa dihapus (label dan urutannya bisa diubah).\n            Jumlah unit tidak ditanyakan: setiap laporan dihitung 1 unit di dashboard.\n            Menghapus pertanyaan tidak menghapus jawaban lama di spreadsheet.</p>\n          <div id=\"ed_FormFields\"></div></div></div>\n        <div data-group=\"stage1\" data-panel=\"Milestones\" class=\"hidden\"><div class=\"card\" style=\"max-width:520px\"><h2>Milestone target kumulatif</h2>\n          <p class=\"muted\">Jumlah unit kumulatif yang diharapkan pada hari ke-N. Dipakai untuk status \"Sesuai target\".</p>\n          <div id=\"ed_Milestones\"></div></div></div>\n        <div data-group=\"stage1\" data-panel=\"s1rep\" class=\"hidden\" data-reports=\"stage1\"></div>\n        <div data-group=\"stage1\" data-panel=\"s1dash\" class=\"hidden\"><div id=\"dashboard_stage1\"></div></div>\n      </div>\n\n      <div data-panel=\"stage2\" class=\"hidden\">\n        <div class=\"card\" data-stage-card=\"stage2\"></div>\n        <div class=\"card\" data-banner=\"stage2\"></div>\n        <div class=\"notice info\">Form dan dashboard Stage 2 belum dibuat. Selama terkunci, Guest melihat stage ini sebagai \"Terkunci\"; jika dibuka, Guest melihat \"Segera hadir\".</div>\n      </div>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n\n  <?!= include('Shared'); ?>\n  <script>\n    var INITIAL_BATCH = '<?= initialBatch ?>';\n    var token = null, all = null, dashState = { stage0: { selected: '' }, stage1: { selected: '' } };\n    var currentTab = 'batches', subTab = { stage0: 's0form', stage1: 'Settings' };\n    try { token = sessionStorage.getItem('btcDevToken'); } catch (e) {}\n\n    function devCall(fn) {\n      var args = Array.prototype.slice.call(arguments, 1);\n      return call.apply(null, [fn, token].concat(args)).catch(function (e) {\n        if (String(e.message).indexOf('SESSION_EXPIRED') >= 0) { logout(); throw new Error('Sesi habis, silakan masuk lagi.'); }\n        throw e;\n      });\n    }\n\n    function showApp(on) {\n      document.getElementById('loginView').classList.toggle('hidden', on);\n      document.getElementById('appView').classList.toggle('hidden', !on);\n      document.getElementById('topActions').classList.toggle('hidden', !on);\n    }\n\n    function logout() {\n      if (token) call('apiDevLogout', token).catch(function () {});\n      token = null;\n      try { sessionStorage.removeItem('btcDevToken'); } catch (e) {}\n      showApp(false);\n    }\n\n    document.getElementById('loginForm').addEventListener('submit', function (e) {\n      e.preventDefault();\n      var msg = document.getElementById('loginMsg');\n      msg.innerHTML = '';\n      call('apiDevLogin', document.getElementById('pw').value).then(function (t) {\n        token = t;\n        try { sessionStorage.setItem('btcDevToken', t); } catch (e) {}\n        document.getElementById('pw').value = '';\n        load(INITIAL_BATCH);\n      }).catch(function (err) { msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>'; });\n    });\n    document.getElementById('logoutBtn').addEventListener('click', logout);\n\n    setTabs(document.getElementById('tabs'), function (tab) {\n      currentTab = tab;\n      refreshPreview();\n    });\n    document.querySelectorAll('nav.tabs[data-group]').forEach(function (nav) {\n      var stage = nav.getAttribute('data-group');\n      setTabs(nav, function (tab) { subTab[stage] = tab; refreshPreview(); });\n    });\n\n    /** Reloads the dashboard preview if it is the panel on screen. */\n    function refreshPreview() {\n      if (currentTab === 'stage0' && subTab.stage0 === 's0dash') loadPreview('stage0');\n      if (currentTab === 'stage1' && subTab.stage1 === 's1dash') loadPreview('stage1');\n    }\n\n    document.getElementById('batchSelect').addEventListener('change', function (e) {\n      dashState.stage0.selected = ''; dashState.stage1.selected = ''; load(e.target.value);\n    });\n\n    function load(batchId) {\n      return devCall('apiDevGetAll', batchId || '').then(apply).catch(function (e) { toast(e.message); });\n    }\n\n    function apply(data) {\n      all = data;\n      showApp(true);\n      var b = data.batch;\n      document.getElementById('subtitle').textContent = 'Batch aktif di panel: ' + b.name + (b.status === 'archived' ? ' (arsip)' : '');\n      document.getElementById('batchSelect').innerHTML = data.batches.map(function (x) {\n        return '<option value=\"' + esc(x.id) + '\"' + (x.id === b.id ? ' selected' : '') + '>' + esc(x.name) + '</option>';\n      }).join('');\n      document.getElementById('lnkSheet').href = data.urls.spreadsheet;\n      document.getElementById('lnkFolder').href = data.urls.folder;\n      document.getElementById('lnkGuest').href = data.urls.app + '?batch=' + encodeURIComponent(b.id);\n      renderBatches();\n      renderBanners();\n      renderStageCards();\n      renderEditors();\n      reportPanels.forEach(function (rp) { rp.render(); });\n      refreshPreview();\n    }\n\n    // ------------------------------------------------------------ stages (name, description, lock)\n    function stageRows() { return all.tables.Stages.rows; }\n\n    function renderStageCards() {\n      stageRows().forEach(function (st) {\n        var tab = document.querySelector('[data-stage-tab=\"' + st.key + '\"]');\n        if (tab) tab.textContent = (st.status === 'open' ? '' : '🔒 ') + st.name;\n        var el = document.querySelector('[data-stage-card=\"' + st.key + '\"]');\n        if (!el) return;\n        el.innerHTML = '<h2>' + esc(st.name) + ' ' + (st.status === 'open' ? '<span class=\"pill ok\">Terbuka untuk santri</span>' : '<span class=\"pill none\">🔒 Terkunci</span>') + '</h2>' +\n          '<p class=\"muted\">Selama terkunci, santri tidak bisa membuka form dan dashboard stage ini. Dev tetap bisa mengatur dan melihat pratinjau di sini.</p>' +\n          '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(240px,1fr))\">' +\n          '<label class=\"field\"><span class=\"lbl\">Nama stage</span><input data-st=\"name\" value=\"' + esc(st.name) + '\"></label>' +\n          '<label class=\"field\"><span class=\"lbl\">Keterangan (tampil di kartu stage)</span><input data-st=\"description\" value=\"' + esc(st.description) + '\"></label></div>' +\n          '<div class=\"row\"><button class=\"btn\" data-st-save>Simpan nama &amp; keterangan</button><span class=\"spacer\"></span>' +\n          (st.status === 'open' ? '<button class=\"btn danger\" data-st-status=\"locked\">Kunci stage</button>'\n            : '<button class=\"btn primary\" data-st-status=\"open\">Buka untuk santri</button>') + '</div>';\n        el.querySelector('[data-st-save]').onclick = function () {\n          saveStage(st.key, { name: el.querySelector('[data-st=\"name\"]').value, description: el.querySelector('[data-st=\"description\"]').value }, 'Stage tersimpan.');\n        };\n        el.querySelector('[data-st-status]').onclick = function () {\n          var to = this.getAttribute('data-st-status');\n          if (!confirm(to === 'open' ? 'Buka ' + st.name + ' untuk santri?' : 'Kunci ' + st.name + '? Santri tidak bisa membukanya sampai dibuka lagi.')) return;\n          saveStage(st.key, { status: to }, to === 'open' ? st.name + ' dibuka.' : st.name + ' dikunci.');\n        };\n      });\n    }\n\n    function saveStage(key, patch, done) {\n      var rows = stageRows().map(function (r) { return r.key === key ? Object.assign({}, r, patch) : r; });\n      devCall('apiDevSaveTable', all.batch.id, 'Stages', rows).then(function (d) { apply(d); toast(done); }).catch(function (e) { toast(e.message); });\n    }\n\n    // ------------------------------------------------------------ batches\n    function renderBatches() {\n      var html = '<table><thead><tr><th>Nama</th><th>ID</th><th>Status</th><th>Default</th><th>Dibuat</th><th></th></tr></thead><tbody>';\n      all.batches.forEach(function (b) {\n        html += '<tr' + (b.id === all.batch.id ? ' class=\"selected\"' : '') + '><td>' + esc(b.name) + '</td><td class=\"muted\">' + esc(b.id) + '</td>' +\n          '<td>' + (b.status === 'archived' ? '<span class=\"pill none\">Arsip</span>' : '<span class=\"pill ok\">Aktif</span>') + '</td>' +\n          '<td>' + (b.isDefault ? '★' : '') + '</td><td class=\"muted\">' + esc(b.createdAt) + '</td><td class=\"actions row\">' +\n          '<button class=\"btn sm\" data-act=\"open\" data-id=\"' + esc(b.id) + '\">Kelola</button>' +\n          (b.isDefault ? '' : '<button class=\"btn sm\" data-act=\"default\" data-id=\"' + esc(b.id) + '\">Jadikan default</button>') +\n          '<button class=\"btn sm\" data-act=\"rename\" data-id=\"' + esc(b.id) + '\">Ganti nama</button>' +\n          (b.status === 'archived' ? '<button class=\"btn sm\" data-act=\"activate\" data-id=\"' + esc(b.id) + '\">Aktifkan</button>'\n            : '<button class=\"btn sm\" data-act=\"archive\" data-id=\"' + esc(b.id) + '\">Arsipkan</button>') +\n          '</td></tr>';\n      });\n      html += '</tbody></table><p class=\"muted\">Batch default tampil pertama di halaman Guest. Batch arsip masih bisa dilihat dashboardnya, tetapi form-nya ditutup.</p>';\n      var el = document.getElementById('batchTable');\n      el.innerHTML = html;\n      el.querySelectorAll('[data-act]').forEach(function (btn) {\n        btn.addEventListener('click', function () {\n          var id = btn.getAttribute('data-id'), act = btn.getAttribute('data-act');\n          if (act === 'open') return load(id);\n          var patch = {};\n          if (act === 'default') patch.isDefault = true;\n          if (act === 'archive') { if (!confirm('Arsipkan batch ini? Form akan ditutup, data tetap aman.')) return; patch.status = 'archived'; }\n          if (act === 'activate') patch.status = 'active';\n          if (act === 'rename') { var n = prompt('Nama baru batch:'); if (!n) return; patch.name = n; }\n          devCall('apiDevUpdateBatch', id, patch).then(function () { return load(all.batch.id); })\n            .then(function () { toast('Batch diperbarui.'); }).catch(function (e) { toast(e.message); });\n        });\n      });\n      document.getElementById('nbSource').innerHTML = '<option value=\"\">(Default bawaan aplikasi)</option>' + all.batches.map(function (b) {\n        return '<option value=\"' + esc(b.id) + '\"' + (b.id === all.batch.id ? ' selected' : '') + '>' + esc(b.name) + '</option>';\n      }).join('');\n      if (!document.getElementById('nbStart').value) document.getElementById('nbStart').value = all.today;\n    }\n\n    document.getElementById('nbCreate').addEventListener('click', function () {\n      var btn = this, name = document.getElementById('nbName').value.trim();\n      if (!name) return toast('Isi nama batch.');\n      btn.disabled = true; btn.textContent = 'Membuat…';\n      devCall('apiDevCreateBatch', {\n        name: name, startDate: document.getElementById('nbStart').value,\n        sourceBatchId: document.getElementById('nbSource').value, copyStudents: document.getElementById('nbStudents').checked\n      }).then(function (d) { apply(d); document.getElementById('nbName').value = ''; toast('Batch \"' + name + '\" dibuat.'); })\n        .catch(function (e) { toast(e.message); })\n        .then(function () { btn.disabled = false; btn.textContent = 'Buat batch'; });\n    });\n\n    document.getElementById('pwBtn').addEventListener('click', function () {\n      var pw = document.getElementById('newPw').value;\n      devCall('apiDevChangePassword', pw).then(function () { document.getElementById('newPw').value = ''; toast('Password diganti.'); })\n        .catch(function (e) { toast(e.message); });\n    });\n\n    // ------------------------------------------------------------ banners (main + one per stage)\n    var bannerShownFor = {};\n    function bannerId(stageKey) {\n      if (!stageKey) return (all.tables.Settings.rows.filter(function (r) { return r.key === 'bannerFileId'; })[0] || {}).value || '';\n      return (stageRows().filter(function (r) { return r.key === stageKey; })[0] || {}).bannerFileId || '';\n    }\n\n    function renderBanners() {\n      document.querySelectorAll('[data-banner]').forEach(function (el) {\n        var stageKey = el.getAttribute('data-banner');\n        if (!el.innerHTML) buildBannerCard(el, stageKey);\n        var id = bannerId(stageKey), key = all.batch.id + '|' + id;\n        if (bannerShownFor[stageKey] === key) return;\n        bannerShownFor[stageKey] = key;\n        var box = el.querySelector('[data-bn-preview]');\n        el.querySelector('[data-bn-remove]').disabled = !id;\n        if (!id) {\n          box.innerHTML = '<p class=\"muted\" style=\"line-height:1.5\">' + (stageKey ? 'Belum ada banner khusus. Stage ini memakai banner utama (tab Umum).' : 'Belum ada banner.') + '</p>';\n          return;\n        }\n        box.innerHTML = '<p class=\"muted\" style=\"line-height:1.5\">Memuat…</p>';\n        call('apiGetBanner', all.batch.id, stageKey, true).then(function (url) {\n          box.innerHTML = url ? '<img src=\"' + url + '\" alt=\"Banner\">' : '<p class=\"muted\" style=\"line-height:1.5\">File banner tidak ditemukan.</p>';\n        });\n      });\n    }\n\n    function buildBannerCard(el, stageKey) {\n      el.innerHTML = (stageKey\n        ? '<h2>Banner stage ini</h2><p class=\"muted\">Tampil paling atas saat santri membuka stage ini (form dan dashboard). Kosongkan untuk memakai banner utama.'\n        : '<h2>Banner utama</h2><p class=\"muted\">Tampil di halaman pilihan stage, dan di setiap stage yang tidak punya banner sendiri.') +\n        ' Disarankan gambar lebar, misalnya 1600 × 400 px.</p>' +\n        '<div class=\"banner\" data-bn-preview style=\"margin-bottom:12px\"></div>' +\n        '<div class=\"row\"><input type=\"file\" data-bn-file accept=\"image/*\" style=\"max-width:320px\">' +\n        '<button class=\"btn primary\" data-bn-upload>Upload banner</button><button class=\"btn danger\" data-bn-remove>Hapus banner</button></div>';\n      var input = el.querySelector('[data-bn-file]');\n      el.querySelector('[data-bn-upload]').addEventListener('click', function () {\n        var file = input.files[0], btn = this;\n        if (!file) return toast('Pilih gambar dulu.');\n        btn.disabled = true; btn.textContent = 'Mengupload…';\n        readFile(file, 2000).then(function (f) { return devCall('apiDevSetBanner', all.batch.id, f, stageKey); })\n          .then(function (d) { input.value = ''; apply(d); toast('Banner tersimpan.'); })\n          .catch(function (e) { toast(e.message); })\n          .then(function () { btn.disabled = false; btn.textContent = 'Upload banner'; });\n      });\n      el.querySelector('[data-bn-remove]').addEventListener('click', function () {\n        if (!confirm(stageKey ? 'Hapus banner stage ini? Stage akan memakai banner utama.' : 'Hapus banner utama?')) return;\n        devCall('apiDevSetBanner', all.batch.id, null, stageKey).then(function (d) { apply(d); toast('Banner dihapus.'); }).catch(function (e) { toast(e.message); });\n      });\n    }\n\n    // ------------------------------------------------------------ table editors\n    var FIELD_TYPES = [['text', 'Jawaban singkat'], ['textarea', 'Paragraf'], ['number', 'Angka'], ['date', 'Tanggal'], ['select', 'Dropdown'],\n      ['radio', 'Pilihan ganda'], ['checkbox', 'Kotak centang'], ['student', 'Nama santri'], ['category', 'Kategori perangkat'], ['file', 'Upload file']];\n    // Form questions the dashboards read. Their key and type are fixed; some also stay active.\n    var SYSTEM_KEYS = { FormFields: ['date', 'student', 'category'], S0_FormFields: ['student'] };\n    var ALWAYS_ACTIVE = { FormFields: ['student', 'category'], S0_FormFields: ['student'] };\n    function isFormTable(name) { return !!SYSTEM_KEYS[name]; }\n    function isSystemField(name, key) { return isFormTable(name) && SYSTEM_KEYS[name].indexOf(key) >= 0; }\n\n    function columnsFor(name) {\n      if (name === 'Settings') return [{ key: 'key', label: 'Key' }, { key: 'value', label: 'Nilai', type: 'textarea' }, { key: 'description', label: 'Keterangan' }];\n      if (name === 'Categories') return [{ key: 'label', label: 'Nama kategori' }, { key: 'key', label: 'Key' },\n        { key: 'defaultTarget', label: 'Target default', type: 'number' }, { key: 'active', label: 'Aktif', type: 'bool' }];\n      if (name === 'Students') {\n        var cols = [{ key: 'name', label: 'Nama lengkap' }, { key: 'nickname', label: 'Panggilan' }, { key: 'active', label: 'Aktif', type: 'bool' }];\n        all.tables.Categories.rows.forEach(function (c) {\n          if (String(c.active) !== 'false') cols.push({ key: 'target:' + c.key, label: 'Target ' + c.label, type: 'number', placeholder: String(c.defaultTarget) });\n        });\n        cols.push({ key: 'notes', label: 'Catatan' }, { key: 'id', label: 'ID', title: 'Dipakai laporan untuk mengenali santri. Kosongkan untuk dibuat otomatis.' });\n        return cols;\n      }\n      if (isFormTable(name)) return [{ key: 'label', label: 'Pertanyaan' }, { key: 'key', label: 'Key' },\n        { key: 'type', label: 'Tipe', type: 'select',\n          options: name === 'FormFields' ? FIELD_TYPES : FIELD_TYPES.filter(function (t) { return t[0] !== 'category'; }) }, { key: 'options', label: 'Pilihan (1 per baris)', type: 'textarea' },\n        { key: 'required', label: 'Wajib', type: 'bool' }, { key: 'section', label: 'Section' }, { key: 'help', label: 'Petunjuk' },\n        { key: 'active', label: 'Aktif', type: 'bool' }];\n      if (name === 'Milestones') return [{ key: 'day', label: 'Hari ke', type: 'number' }, { key: 'units', label: 'Jml unit kumulatif', type: 'number' }];\n    }\n\n    function newRowFor(name) {\n      if (name === 'Students' || name === 'Categories') return { active: true };\n      if (isFormTable(name)) return { type: 'text', active: true, required: false };\n      return {};\n    }\n\n    function renderEditors() {\n      ['Settings', 'Students', 'Categories', 'FormFields', 'Milestones', 'S0_FormFields'].forEach(function (name) {\n        tableEditor(document.getElementById('ed_' + name), name, columnsFor(name), all.tables[name].rows);\n      });\n    }\n\n    function isTrue(v) { return v === true || String(v).toLowerCase() === 'true'; }\n\n    /** Cells that cannot change for a row, with the reason shown on hover. */\n    function lockReason(name, col, row) {\n      if (!isSystemField(name, row.key)) return '';\n      if (col.key === 'key' || col.key === 'type') return 'Dipakai dashboard, tidak bisa diubah';\n      if (col.key === 'active' && ALWAYS_ACTIVE[name].indexOf(row.key) >= 0) return 'Dashboard butuh pertanyaan ini, jadi selalu aktif';\n      return '';\n    }\n\n    function cellInput(name, col, row) {\n      var v = row[col.key] == null ? '' : row[col.key];\n      var lock = lockReason(name, col, row);\n      var attrs = ' data-k=\"' + esc(col.key) + '\"' + (lock ? ' disabled title=\"' + esc(lock) + '\"' : (col.title ? ' title=\"' + esc(col.title) + '\"' : ''));\n      if (col.type === 'bool') return '<input type=\"checkbox\"' + attrs + (isTrue(v) || (lock && col.key === 'active') ? ' checked' : '') + '>';\n      if (col.type === 'select') {\n        return '<select' + attrs + '>' + col.options.map(function (o) {\n          return '<option value=\"' + esc(o[0]) + '\"' + (o[0] === v ? ' selected' : '') + '>' + esc(o[1]) + '</option>';\n        }).join('') + '</select>';\n      }\n      if (col.type === 'textarea') return '<textarea' + attrs + ' rows=\"1\">' + esc(v) + '</textarea>';\n      return '<input' + attrs + (col.type === 'number' ? ' type=\"number\"' : '') +\n        (col.placeholder ? ' placeholder=\"' + esc(col.placeholder) + '\"' : '') + ' value=\"' + esc(v) + '\">';\n    }\n\n    function bulkValueInput(col) {\n      if (!col) return '';\n      if (col.type === 'bool') return '<select data-bulk=\"value\"><option value=\"true\">Ya / aktif</option><option value=\"false\">Tidak / nonaktif</option></select>';\n      if (col.type === 'select') return '<select data-bulk=\"value\">' + col.options.map(function (o) { return '<option value=\"' + esc(o[0]) + '\">' + esc(o[1]) + '</option>'; }).join('') + '</select>';\n      return '<input data-bulk=\"value\"' + (col.type === 'number' ? ' type=\"number\"' : '') + ' placeholder=\"Nilai baru (kosongkan untuk menghapus isi)\">';\n    }\n\n    function compareValues(a, b, col) {\n      if (col.type === 'bool') return (isTrue(a) ? 1 : 0) - (isTrue(b) ? 1 : 0);\n      if (col.type === 'number') {\n        var na = a === '' || a == null ? -Infinity : Number(a), nb = b === '' || b == null ? -Infinity : Number(b);\n        return na - nb;\n      }\n      return String(a == null ? '' : a).localeCompare(String(b == null ? '' : b), 'id', { numeric: true, sensitivity: 'base' });\n    }\n\n    /**\n     * Editable table: every cell is an input, rows have checkboxes for bulk delete / duplicate / edit,\n     * column headers sort, and nothing is written until \"Simpan\".\n     */\n    function tableEditor(el, name, cols, rows) {\n      rows = rows.map(function (r) { return Object.assign({}, r); });\n      if (isFormTable(name)) rows.sort(function (a, b) { return Number(a.order || 0) - Number(b.order || 0); });\n      var selected = [];   // parallel to rows\n      var sort = { key: '', dir: 1 };\n      var dirty = false;\n      var bulkCol = cols[0].key;\n\n      function selCount() { return selected.filter(Boolean).length; }\n\n      function draw() {\n        while (selected.length < rows.length) selected.push(false);\n        selected.length = rows.length;\n        var n = selCount();\n        var col = cols.filter(function (c) { return c.key === bulkCol; })[0];\n        var html = '<div class=\"bulkbar row' + (n ? '' : ' muted') + '\">' +\n          '<strong>' + n + ' dipilih</strong>' +\n          '<button class=\"btn sm danger\" data-m=\"bulkdel\"' + (n ? '' : ' disabled') + '>Hapus terpilih</button>' +\n          '<button class=\"btn sm\" data-m=\"bulkdup\"' + (n ? '' : ' disabled') + '>Duplikat</button>' +\n          '<span class=\"row\">Ubah kolom <select data-bulk=\"col\" style=\"width:auto\">' + cols.map(function (c) {\n            return '<option value=\"' + esc(c.key) + '\"' + (c.key === bulkCol ? ' selected' : '') + '>' + esc(c.label) + '</option>';\n          }).join('') + '</select> menjadi ' + bulkValueInput(col) +\n          '<button class=\"btn sm\" data-m=\"bulkset\"' + (n ? '' : ' disabled') + '>Terapkan</button></span>' +\n          '</div>';\n        html += '<div class=\"table-wrap\"><table class=\"editor\"><thead><tr>' +\n          '<th class=\"sel\"><input type=\"checkbox\" data-m=\"selall\" title=\"Pilih semua\"' + (n && n === rows.length ? ' checked' : '') + '></th><th>No</th>' +\n          cols.map(function (c) {\n            var mark = sort.key === c.key ? (sort.dir > 0 ? ' ▲' : ' ▼') : '';\n            return '<th class=\"sortable\" data-sort=\"' + esc(c.key) + '\" title=\"Klik untuk mengurutkan\">' + esc(c.label) + mark + '</th>';\n          }).join('') + '<th></th></tr></thead><tbody>';\n        rows.forEach(function (r, i) {\n          var sys = isSystemField(name, r.key);\n          html += '<tr data-i=\"' + i + '\"' + (selected[i] ? ' class=\"selected\"' : '') + '>' +\n            '<td class=\"sel\"><input type=\"checkbox\" data-sel' + (selected[i] ? ' checked' : '') + '></td><td class=\"muted\">' + (i + 1) + '</td>' +\n            cols.map(function (c) { return '<td>' + cellInput(name, c, r) + '</td>'; }).join('') +\n            '<td class=\"actions\"><button class=\"btn sm\" data-m=\"up\" title=\"Naik\">↑</button><button class=\"btn sm\" data-m=\"down\" title=\"Turun\">↓</button>' +\n            (sys ? '' : '<button class=\"btn sm danger\" data-m=\"del\" title=\"Hapus\">✕</button>') + '</td></tr>';\n        });\n        if (!rows.length) html += '<tr><td colspan=\"' + (cols.length + 3) + '\" class=\"muted\">Belum ada data. Klik \"+ Tambah baris\".</td></tr>';\n        html += '</tbody></table></div><div class=\"row\" style=\"margin-top:12px\">' +\n          '<button class=\"btn\" data-m=\"add\">+ Tambah baris</button>' +\n          '<button class=\"btn\" data-m=\"addmany\">+ Tambah banyak</button>' +\n          '<span class=\"spacer\"></span>' + '<span class=\"muted' + (dirty ? '' : ' hidden') + '\" data-dirty>Ada perubahan yang belum disimpan</span>' +\n          '<button class=\"btn primary\" data-m=\"save\">Simpan</button></div>' +\n          '<div class=\"card hidden\" data-panel-many style=\"margin-top:12px\">' + manyHelp() +\n          '<textarea data-many rows=\"8\" style=\"margin:8px 0\"></textarea>' +\n          '<div class=\"row\"><button class=\"btn primary\" data-m=\"addmanygo\">Tambahkan ke tabel</button><button class=\"btn\" data-m=\"addmanyclose\">Batal</button></div></div>';\n        el.innerHTML = html;\n      }\n\n      function manyHelp() {\n        var keys = cols.filter(function (c) { return !lockReason(name, c, {}); }).map(function (c) { return c.label; });\n        if (name === 'Students') return '<strong>Tambah banyak santri</strong><p class=\"muted\">Tempel daftar nama, satu santri per baris. ' +\n          'Boleh ditambah panggilan dipisah koma, titik koma, atau tab (bisa langsung copy dari Excel/Sheets). Contoh:<br><code>Abdul Latif; Abdul</code><br><code>Alfiyan Ardiansyah</code></p>';\n        return '<strong>Tambah banyak baris</strong><p class=\"muted\">Satu baris per data, kolom dipisah titik koma atau tab, urutannya: ' + esc(keys.join(' ; ')) + '.</p>';\n      }\n\n      function collect() {\n        el.querySelectorAll('tbody tr[data-i]').forEach(function (tr) {\n          var i = Number(tr.getAttribute('data-i')), r = rows[i];\n          tr.querySelectorAll('[data-k]').forEach(function (inp) {\n            if (inp.disabled) return;\n            r[inp.getAttribute('data-k')] = inp.type === 'checkbox' ? inp.checked : inp.value;\n          });\n          var s = tr.querySelector('[data-sel]');\n          selected[i] = !!(s && s.checked);\n        });\n      }\n\n      function parseMany(text) {\n        var editable = cols.filter(function (c) { return !lockReason(name, c, {}); });\n        var order = name === 'Students' ? [cols[0], cols[1]] : editable;\n        var seen = {};\n        rows.forEach(function (r) { if (r.name) seen[String(r.name).trim().toLowerCase()] = true; });\n        var added = 0, skipped = 0;\n        text.split(/\\r?\\n/).forEach(function (line) {\n          if (!line.trim()) return;\n          var parts = line.split(/\\t|;|,(?=\\s*[^,]*$)/).map(function (p) { return p.trim(); });\n          if (name !== 'Students') parts = line.split(/\\t|;/).map(function (p) { return p.trim(); });\n          var r = newRowFor(name);\n          order.forEach(function (c, j) {\n            if (parts[j] === undefined || parts[j] === '') return;\n            r[c.key] = c.type === 'bool' ? /^(1|ya|y|yes|true|aktif)$/i.test(parts[j]) : parts[j];\n          });\n          if (name === 'Students') {\n            var k = String(r.name || '').toLowerCase();\n            if (!k || seen[k]) { skipped++; return; }\n            seen[k] = true;\n          }\n          rows.push(r); selected.push(false); added++;\n        });\n        return { added: added, skipped: skipped };\n      }\n\n      el.onchange = function (e) {\n        var t = e.target;\n        if (t.getAttribute('data-bulk') === 'col') { collect(); bulkCol = t.value; draw(); return; }\n        if (t.hasAttribute('data-sel')) {\n          collect();\n          var tr = t.closest('tr');\n          tr.classList.toggle('selected', t.checked);\n          refreshBar();\n          return;\n        }\n        if (t.getAttribute('data-m') === 'selall') {\n          collect();\n          for (var i = 0; i < rows.length; i++) selected[i] = t.checked;\n          draw();\n          return;\n        }\n        if (t.hasAttribute('data-k')) { dirty = true; el.querySelector('[data-dirty]').classList.remove('hidden'); }\n      };\n\n      function refreshBar() {\n        var n = selCount();\n        el.querySelector('.bulkbar strong').textContent = n + ' dipilih';\n        el.querySelector('.bulkbar').classList.toggle('muted', !n);\n        el.querySelectorAll('[data-m=\"bulkdel\"],[data-m=\"bulkdup\"],[data-m=\"bulkset\"]').forEach(function (b) { b.disabled = !n; });\n        var box = el.querySelector('[data-m=\"selall\"]');\n        if (box) box.checked = n > 0 && n === rows.length;\n      }\n\n      el.onclick = function (e) {\n        var th = e.target.closest('th[data-sort]');\n        if (th) {\n          collect();\n          var key = th.getAttribute('data-sort');\n          sort = { key: key, dir: sort.key === key ? -sort.dir : 1 };\n          var col = cols.filter(function (c) { return c.key === key; })[0];\n          var idx = rows.map(function (r, i) { return i; });\n          idx.sort(function (a, b) { return compareValues(rows[a][key], rows[b][key], col) * sort.dir || a - b; });\n          rows = idx.map(function (i) { return rows[i]; });\n          selected = idx.map(function (i) { return selected[i]; });\n          dirty = true;\n          draw();\n          return;\n        }\n        var b = e.target.closest('button[data-m]');\n        if (!b) return;\n        collect();\n        var m = b.getAttribute('data-m'), tr = b.closest('tr'), i = tr ? Number(tr.getAttribute('data-i')) : -1;\n        var keep = function (r, j) { return !selected[j] || isSystemField(name, r.key); };\n        if (m === 'add') { rows.push(newRowFor(name)); selected.push(false); dirty = true; }\n        if (m === 'addmany') { el.querySelector('[data-panel-many]').classList.remove('hidden'); el.querySelector('[data-many]').focus(); return; }\n        if (m === 'addmanyclose') { el.querySelector('[data-panel-many]').classList.add('hidden'); return; }\n        if (m === 'addmanygo') {\n          var res = parseMany(el.querySelector('[data-many]').value);\n          if (res.added) dirty = true;\n          toast(res.added + ' baris ditambahkan' + (res.skipped ? ', ' + res.skipped + ' dilewati (nama kosong atau sudah ada)' : '') + '. Klik Simpan untuk menyimpan.');\n        }\n        if (m === 'del') { if (!confirm('Hapus baris ini?')) return; rows.splice(i, 1); selected.splice(i, 1); dirty = true; }\n        if (m === 'bulkdel') {\n          var n = selCount();\n          if (!confirm('Hapus ' + n + ' baris terpilih? Perubahan baru tersimpan setelah klik Simpan.')) return;\n          var keptSel = [];\n          rows = rows.filter(function (r, j) { var k = keep(r, j); if (k) keptSel.push(false); return k; });\n          selected = keptSel;\n          dirty = true;\n        }\n        if (m === 'bulkdup') {\n          var copies = rows.filter(function (r, j) { return selected[j]; }).map(function (r) {\n            var c = Object.assign({}, r);\n            delete c.id;\n            if (isFormTable(name) || name === 'Categories') { c.key = ''; c.label = (c.label || '') + ' (salinan)'; }\n            if (name === 'Students') c.name = (c.name || '') + ' (salinan)';\n            return c;\n          });\n          rows = rows.concat(copies);\n          selected = selected.map(function () { return false; }).concat(copies.map(function () { return true; }));\n          dirty = true;\n        }\n        if (m === 'bulkset') {\n          var col = cols.filter(function (c) { return c.key === bulkCol; })[0];\n          var inp = el.querySelector('[data-bulk=\"value\"]');\n          var val = col.type === 'bool' ? inp.value === 'true' : inp.value;\n          var changed = 0;\n          rows.forEach(function (r, j) {\n            if (!selected[j] || lockReason(name, col, r)) return;\n            r[col.key] = val; changed++;\n          });\n          dirty = true;\n          toast(changed + ' baris diubah. Klik Simpan untuk menyimpan.');\n        }\n        if (m === 'up' && i > 0) { rows.splice(i - 1, 0, rows.splice(i, 1)[0]); selected.splice(i - 1, 0, selected.splice(i, 1)[0]); dirty = true; }\n        if (m === 'down' && i < rows.length - 1) { rows.splice(i + 1, 0, rows.splice(i, 1)[0]); selected.splice(i + 1, 0, selected.splice(i, 1)[0]); dirty = true; }\n        if (m === 'save') {\n          b.disabled = true; b.textContent = 'Menyimpan…';\n          devCall('apiDevSaveTable', all.batch.id, name, rows).then(function (d) { apply(d); toast('Tersimpan.'); })\n            .catch(function (err) { toast(err.message); b.disabled = false; b.textContent = 'Simpan'; });\n          return;\n        }\n        draw();\n      };\n      draw();\n    }\n\n    // ------------------------------------------------------------ reports (one panel per stage)\n    /** Report list for one stage: filter, inline edit, add, single and bulk delete. */\n    function reportsPanel(stageKey, fieldsTable, reportsTable) {\n      var root = document.querySelector('[data-reports=\"' + stageKey + '\"]');\n      root.innerHTML = '<div class=\"card\"><h2>Laporan</h2><div class=\"row\" style=\"margin-bottom:12px\">' +\n        '<input data-filter placeholder=\"Cari nama / tanggal…\" style=\"max-width:280px\"><span class=\"spacer\"></span>' +\n        '<button class=\"btn danger\" data-bulkdel disabled>Hapus terpilih</button><button class=\"btn\" data-add>+ Tambah laporan</button></div>' +\n        '<div class=\"table-wrap\" data-table></div></div>';\n      var filter = root.querySelector('[data-filter]'), bulkDel = root.querySelector('[data-bulkdel]'), table = root.querySelector('[data-table]');\n      var editing = null, selectedIds = {};\n\n      function columns() {\n        var fields = all.tables[fieldsTable].rows.slice().sort(function (a, b) { return Number(a.order || 0) - Number(b.order || 0); });\n        var keys = fields.map(function (f) { return f.key; });\n        var labels = {};\n        fields.forEach(function (f) { labels[f.key] = f.label; });\n        // Columns that exist in the sheet but are no longer in the form (old answers) still show at the end.\n        all.tables[reportsTable].headers.forEach(function (h) {\n          if (['id', 'submittedAt', 'updatedAt', 'studentName'].indexOf(h) < 0 && keys.indexOf(h) < 0) keys.push(h);\n        });\n        return { keys: keys, labels: labels, fields: fields };\n      }\n\n      function cellEditor(key, value, fields) {\n        var f = fields.filter(function (x) { return x.key === key; })[0];\n        var type = f ? f.type : 'text';\n        if (type === 'student') {\n          return '<select data-k=\"' + esc(key) + '\"><option value=\"\"></option>' + all.tables.Students.rows.map(function (s) {\n            return '<option value=\"' + esc(s.id) + '\"' + (String(s.id) === String(value) ? ' selected' : '') + '>' + esc(s.name) + '</option>';\n          }).join('') + '</select>';\n        }\n        if (type === 'category') {\n          return '<select data-k=\"' + esc(key) + '\"><option value=\"\"></option>' + all.tables.Categories.rows.map(function (c) {\n            return '<option value=\"' + esc(c.key) + '\"' + (String(c.key) === String(value) ? ' selected' : '') + '>' + esc(c.label) + '</option>';\n          }).join('') + '</select>';\n        }\n        var t = type === 'number' ? 'number' : type === 'date' ? 'date' : 'text';\n        return '<input type=\"' + t + '\" data-k=\"' + esc(key) + '\" value=\"' + esc(value) + '\">';\n      }\n\n      function display(key, value, fields) {\n        var f = fields.filter(function (x) { return x.key === key; })[0];\n        if (f && f.type === 'student') { var s = all.tables.Students.rows.filter(function (x) { return String(x.id) === String(value); })[0]; return esc(s ? s.name : value); }\n        if (f && f.type === 'category') { var c = all.tables.Categories.rows.filter(function (x) { return String(x.key) === String(value); })[0]; return esc(c ? c.label : value); }\n        if (/^https:\\/\\//.test(String(value))) return '<a href=\"' + esc(value) + '\" target=\"_blank\">Buka</a>';\n        return esc(value);\n      }\n\n      function render() {\n        var cols = columns();\n        var q = filter.value.trim().toLowerCase();\n        var rows = all.tables[reportsTable].rows.slice().reverse();\n        if (editing === 'new') rows.unshift({ id: '' });\n        if (q) rows = rows.filter(function (r) { return !r.id || JSON.stringify(r).toLowerCase().indexOf(q) >= 0; });\n        var html = '<table class=\"editor\"><thead><tr><th class=\"sel\"><input type=\"checkbox\" data-selall title=\"Pilih semua yang tampil\"></th><th>Dikirim</th>' +\n          cols.keys.map(function (k) { return '<th>' + esc(cols.labels[k] || k) + '</th>'; }).join('') + '<th></th></tr></thead><tbody>';\n        rows.slice(0, 300).forEach(function (r) {\n          var isEditing = (editing === 'new' && !r.id) || (r.id && editing === r.id);\n          html += '<tr data-id=\"' + esc(r.id) + '\"' + (selectedIds[r.id] ? ' class=\"selected\"' : '') + '><td class=\"sel\">' +\n            (r.id ? '<input type=\"checkbox\" data-rsel' + (selectedIds[r.id] ? ' checked' : '') + '>' : '') + '</td><td class=\"muted\">' + esc(r.submittedAt || 'baru') + '</td>' +\n            cols.keys.map(function (k) {\n              var v = r[k] == null ? '' : r[k];\n              return '<td>' + (isEditing ? cellEditor(k, v, cols.fields) : display(k, v, cols.fields)) + '</td>';\n            }).join('') + '<td class=\"actions\">' + (isEditing\n            ? '<button class=\"btn sm primary\" data-r=\"save\">Simpan</button><button class=\"btn sm\" data-r=\"cancel\">Batal</button>'\n            : '<button class=\"btn sm\" data-r=\"edit\">Edit</button><button class=\"btn sm danger\" data-r=\"del\">Hapus</button>') + '</td></tr>';\n        });\n        if (!rows.length) html += '<tr><td colspan=\"' + (cols.keys.length + 3) + '\" class=\"muted\">Belum ada laporan.</td></tr>';\n        html += '</tbody></table>';\n        if (rows.length > 300) html += '<p class=\"muted\">Menampilkan 300 laporan terbaru. Gunakan pencarian atau buka spreadsheet untuk data lengkap.</p>';\n        table.innerHTML = html;\n        updateBulk();\n      }\n\n      function updateBulk() {\n        var n = Object.keys(selectedIds).filter(function (k) { return selectedIds[k]; }).length;\n        bulkDel.disabled = !n;\n        bulkDel.textContent = n ? 'Hapus ' + n + ' terpilih' : 'Hapus terpilih';\n      }\n\n      table.addEventListener('change', function (e) {\n        var t = e.target;\n        if (t.hasAttribute('data-selall')) {\n          table.querySelectorAll('[data-rsel]').forEach(function (c) {\n            c.checked = t.checked;\n            selectedIds[c.closest('tr').getAttribute('data-id')] = t.checked;\n            c.closest('tr').classList.toggle('selected', t.checked);\n          });\n        } else if (t.hasAttribute('data-rsel')) {\n          selectedIds[t.closest('tr').getAttribute('data-id')] = t.checked;\n          t.closest('tr').classList.toggle('selected', t.checked);\n        } else return;\n        updateBulk();\n      });\n\n      bulkDel.addEventListener('click', function () {\n        var ids = Object.keys(selectedIds).filter(function (k) { return selectedIds[k]; });\n        if (!ids.length || !confirm('Hapus ' + ids.length + ' laporan terpilih? Tidak bisa dibatalkan.')) return;\n        bulkDel.disabled = true;\n        devCall('apiDevDeleteReport', all.batch.id, ids, stageKey).then(function (d) { selectedIds = {}; apply(d); toast(ids.length + ' laporan dihapus.'); })\n          .catch(function (err) { toast(err.message); bulkDel.disabled = false; });\n      });\n\n      filter.addEventListener('input', render);\n      root.querySelector('[data-add]').addEventListener('click', function () { editing = 'new'; render(); });\n      table.addEventListener('click', function (e) {\n        var b = e.target.closest('[data-r]');\n        if (!b) return;\n        var tr = b.closest('tr'), id = tr.getAttribute('data-id'), act = b.getAttribute('data-r');\n        if (act === 'edit') { editing = id; return render(); }\n        if (act === 'cancel') { editing = null; return render(); }\n        if (act === 'del') {\n          if (!confirm('Hapus laporan ini? Tidak bisa dibatalkan.')) return;\n          return devCall('apiDevDeleteReport', all.batch.id, id, stageKey).then(function (d) { apply(d); toast('Laporan dihapus.'); }).catch(function (err) { toast(err.message); });\n        }\n        if (act === 'save') {\n          var row = { id: id };\n          tr.querySelectorAll('[data-k]').forEach(function (inp) { row[inp.getAttribute('data-k')] = inp.value; });\n          b.disabled = true;\n          devCall('apiDevSaveReport', all.batch.id, row, stageKey).then(function (d) { editing = null; apply(d); toast('Laporan tersimpan.'); })\n            .catch(function (err) { toast(err.message); b.disabled = false; });\n        }\n      });\n\n      return { render: render };\n    }\n\n    var reportPanels = [reportsPanel('stage0', 'S0_FormFields', 'S0_Reports'), reportsPanel('stage1', 'FormFields', 'Reports')];\n\n    // ------------------------------------------------------------ dashboard preview (also for locked stages)\n    function loadPreview(stageKey) {\n      var el = document.getElementById('dashboard_' + stageKey);\n      el.innerHTML = '<div class=\"loading\">Memuat dashboard…</div>';\n      devCall('apiDevGetDashboard', all.batch.id, stageKey).then(function (d) {\n        renderAnyDashboard(el, d, dashState[stageKey]);\n        var notes = '';\n        if (d.stage.status !== 'open') notes += '<div class=\"notice info\">Pratinjau: stage ini masih terkunci, jadi santri belum bisa melihat dashboard ini.</div>';\n        if (d.unmatchedReports) notes += '<div class=\"notice err\">' + d.unmatchedReports +\n          ' laporan tidak terhitung karena nama santri' + (stageKey === 'stage1' ? ' atau kategorinya' : '') + ' tidak dikenali. Periksa tab Laporan.</div>';\n        if (notes) el.insertAdjacentHTML('afterbegin', notes);\n      }).catch(function (e) { el.innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>'; });\n    }\n\n    if (token) load(INITIAL_BATCH).then(function () { if (!all) showApp(false); });\n  </script>\n</body>\n</html>\n",
  "Index": "<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <?!= include('Styles'); ?>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js\"></script>\n</head>\n<body>\n  <div id=\"banner\" class=\"banner hidden\"><img id=\"bannerImg\" alt=\"Banner\"></div>\n  <header class=\"top\">\n    <div>\n      <h1>BTC - Boarding Technician Camp</h1>\n      <div class=\"sub\" id=\"subtitle\"></div>\n    </div>\n    <label class=\"row\"><span class=\"muted\">Batch</span>\n      <select id=\"batchSelect\" style=\"width:auto\"></select>\n    </label>\n  </header>\n  <main>\n    <section id=\"home\">\n      <h2 style=\"margin:0 0 12px\">Pilih stage</h2>\n      <div class=\"grid stage-grid\" id=\"stageList\"><div class=\"loading\">Memuat…</div></div>\n    </section>\n\n    <section id=\"stageView\" class=\"hidden\">\n      <div class=\"row\" style=\"margin-bottom:8px\">\n        <button class=\"btn sm\" id=\"backBtn\">← Semua stage</button>\n        <h2 id=\"stageTitle\" style=\"margin:0\"></h2>\n      </div>\n      <nav class=\"tabs\" id=\"tabs\">\n        <button data-tab=\"form\" class=\"active\">Isi Laporan</button>\n        <button data-tab=\"dashboard\">Dashboard</button>\n      </nav>\n      <section data-panel=\"form\">\n        <div class=\"card\" style=\"max-width:720px\">\n          <h2 id=\"formTitle\">Laporan</h2>\n          <p class=\"muted\" id=\"formDesc\"></p>\n          <div id=\"formMsg\"></div>\n          <form id=\"reportForm\" novalidate></form>\n        </div>\n      </section>\n      <section data-panel=\"dashboard\" class=\"hidden\">\n        <h2 id=\"dashTitle\" style=\"margin:0 0 12px\">Dashboard</h2>\n        <div id=\"dashboard\"></div>\n      </section>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n\n  <?!= include('Shared'); ?>\n  <script>\n    var INITIAL_BATCH = '<?= initialBatch ?>', INITIAL_STAGE = '<?= initialStage ?>', INITIAL_VIEW = '<?= initialView ?>';\n    var pub = null, stage = null, form = null, dash = {}, dashState = { selected: '' }, currentTab = 'form';\n\n    setTabs(document.getElementById('tabs'), function (tab) {\n      currentTab = tab;\n      if (tab === 'dashboard') loadDashboard();\n    });\n\n    document.getElementById('batchSelect').addEventListener('change', function (e) {\n      loadPublic(e.target.value);\n    });\n    document.getElementById('backBtn').addEventListener('click', showHome);\n\n    function loadPublic(batchId) {\n      document.getElementById('stageList').innerHTML = '<div class=\"loading\">Memuat…</div>';\n      showHome();\n      return call('apiGetPublic', batchId || '').then(function (p) {\n        pub = p;\n        dash = {};\n        var sel = document.getElementById('batchSelect');\n        sel.innerHTML = p.batches.map(function (b) {\n          return '<option value=\"' + esc(b.id) + '\"' + (b.id === p.batch.id ? ' selected' : '') + '>' +\n            esc(b.name) + (b.status === 'archived' ? ' (arsip)' : '') + '</option>';\n        }).join('');\n        document.getElementById('subtitle').textContent = p.batchName;\n        renderStages();\n        loadBanner(p.batch.id);\n      }).catch(function (e) {\n        document.getElementById('stageList').innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>';\n      });\n    }\n\n    // Main banner on the stage picker; each stage shows its own (the server falls back to the main one).\n    var bannerReq = 0;\n    function loadBanner(batchId, stageKey) {\n      var req = ++bannerReq;\n      call('apiGetBanner', batchId, stageKey || '').then(function (url) {\n        if (req !== bannerReq || !pub || pub.batch.id !== batchId) return;\n        document.getElementById('bannerImg').src = url || '';\n        document.getElementById('banner').classList.toggle('hidden', !url);\n      }).catch(function () { document.getElementById('banner').classList.add('hidden'); });\n    }\n\n    function renderStages() {\n      var el = document.getElementById('stageList');\n      el.innerHTML = pub.stages.map(function (st) {\n        var usable = !!pub.forms[st.key];\n        var pill = st.status !== 'open' ? '<span class=\"pill none\">🔒 Terkunci</span>'\n          : usable ? '<span class=\"pill ok\">Terbuka</span>' : '<span class=\"pill none\">Segera hadir</span>';\n        return '<button class=\"stage-card\" data-stage=\"' + esc(st.key) + '\"' + (usable ? '' : ' disabled') + '>' +\n          '<span class=\"name\">' + esc(st.name) + '</span><span class=\"desc\">' + esc(st.description) + '</span><span>' + pill + '</span></button>';\n      }).join('');\n      el.querySelectorAll('[data-stage]').forEach(function (b) {\n        b.addEventListener('click', function () { openStage(b.getAttribute('data-stage')); });\n      });\n    }\n\n    function showHome() {\n      if (stage && pub) loadBanner(pub.batch.id);\n      stage = null;\n      document.getElementById('home').classList.remove('hidden');\n      document.getElementById('stageView').classList.add('hidden');\n    }\n\n    function openStage(key, view) {\n      if (!pub.forms[key]) return;\n      stage = pub.stages.filter(function (s) { return s.key === key; })[0];\n      form = pub.forms[key];\n      dashState.selected = '';\n      document.getElementById('home').classList.add('hidden');\n      document.getElementById('stageView').classList.remove('hidden');\n      document.getElementById('stageTitle').textContent = stage.name;\n      loadBanner(pub.batch.id, key);\n      document.getElementById('formTitle').textContent = form.settings.formTitle;\n      document.getElementById('formDesc').textContent = form.settings.formDescription;\n      document.getElementById('dashTitle').textContent = form.settings.dashboardTitle;\n      renderForm();\n      document.querySelector('#tabs [data-tab=\"' + (view === 'dashboard' ? 'dashboard' : 'form') + '\"]').click();\n    }\n\n    function renderForm() {\n      var el = document.getElementById('reportForm');\n      document.getElementById('formMsg').innerHTML = '';\n      if (!form.settings.formOpen) {\n        el.innerHTML = '<div class=\"notice info\">Form untuk batch ini sedang ditutup.</div>';\n        return;\n      }\n      var html = '', section = null;\n      form.fields.forEach(function (f) {\n        if (f.section && f.section !== section) { section = f.section; html += '<h3>' + esc(section) + '</h3>'; }\n        html += fieldHtml(f);\n      });\n      html += '<div class=\"row\"><button class=\"btn primary\" type=\"submit\" id=\"submitBtn\">Kirim laporan</button></div>';\n      el.innerHTML = html;\n    }\n\n    function fieldHtml(f) {\n      var id = 'f_' + f.key, name = esc(f.key), req = f.required ? ' required' : '';\n      var input = '';\n      switch (f.type) {\n        case 'textarea': input = '<textarea id=\"' + id + '\" name=\"' + name + '\"' + req + '></textarea>'; break;\n        case 'number': input = '<input type=\"number\" inputmode=\"numeric\" min=\"0\" step=\"1\" id=\"' + id + '\" name=\"' + name + '\"' + req + '>'; break;\n        case 'date': input = '<input type=\"date\" id=\"' + id + '\" name=\"' + name + '\" value=\"' + esc(pub.today) + '\"' + req + '>'; break;\n        case 'student':\n          input = '<select id=\"' + id + '\" name=\"' + name + '\"' + req + '><option value=\"\">— Pilih nama —</option>' +\n            pub.students.map(function (s) { return '<option value=\"' + esc(s.id) + '\">' + esc(s.name) + '</option>'; }).join('') + '</select>';\n          break;\n        case 'select':\n          input = '<select id=\"' + id + '\" name=\"' + name + '\"' + req + '><option value=\"\">— Pilih —</option>' +\n            f.options.map(function (o) { return '<option>' + esc(o) + '</option>'; }).join('') + '</select>';\n          break;\n        case 'category':\n        case 'radio':\n          var opts = f.type === 'category' ? form.categories.map(function (c) { return { v: c.key, l: c.label }; })\n            : f.options.map(function (o) { return { v: o, l: o }; });\n          input = opts.map(function (o) {\n            return '<label class=\"choice\"><input type=\"radio\" name=\"' + name + '\" value=\"' + esc(o.v) + '\"> ' + esc(o.l) + '</label>';\n          }).join('');\n          break;\n        case 'checkbox':\n          input = f.options.map(function (o) {\n            return '<label class=\"choice\"><input type=\"checkbox\" name=\"' + name + '\" value=\"' + esc(o) + '\"> ' + esc(o) + '</label>';\n          }).join('');\n          break;\n        case 'file':\n          input = '<input type=\"file\" id=\"' + id + '\" name=\"' + name + '\" accept=\"image/*,video/*\" data-preview=\"pv_' + esc(f.key) + '\">' +\n            '<div class=\"file-preview\" id=\"pv_' + esc(f.key) + '\"></div>';\n          break;\n        default: input = '<input type=\"text\" id=\"' + id + '\" name=\"' + name + '\"' + req + '>';\n      }\n      var wrap = (f.type === 'radio' || f.type === 'category' || f.type === 'checkbox') ? 'div' : 'label';\n      return '<' + wrap + ' class=\"field\"><span class=\"lbl\">' + esc(f.label) + (f.required ? ' <span class=\"req\">*</span>' : '') + '</span>' +\n        (f.help ? '<span class=\"help\">' + esc(f.help) + '</span>' : '') + input + '</' + wrap + '>';\n    }\n\n    // Small preview under each photo/video input.\n    document.getElementById('reportForm').addEventListener('change', function (e) {\n      var t = e.target;\n      if (t.type !== 'file' || !t.getAttribute('data-preview')) return;\n      var box = document.getElementById(t.getAttribute('data-preview'));\n      var file = t.files[0];\n      box.innerHTML = '';\n      if (!file) return;\n      var url = URL.createObjectURL(file);\n      box.innerHTML = /^video\\//.test(file.type) ? '<video src=\"' + url + '\" muted controls></video>' : '<img src=\"' + url + '\" alt=\"\">';\n    });\n\n    document.getElementById('reportForm').addEventListener('submit', function (e) {\n      e.preventDefault();\n      var el = e.target, answers = {}, missing = [], pending = [];\n      form.fields.forEach(function (f) {\n        if (f.type === 'checkbox') {\n          answers[f.key] = Array.prototype.map.call(el.querySelectorAll('input[name=\"' + f.key + '\"]:checked'), function (x) { return x.value; });\n          if (f.required && !answers[f.key].length) missing.push(f.label);\n        } else if (f.type === 'radio' || f.type === 'category') {\n          var c = el.querySelector('input[name=\"' + f.key + '\"]:checked');\n          answers[f.key] = c ? c.value : '';\n          if (f.required && !c) missing.push(f.label);\n        } else if (f.type === 'file') {\n          var file = el.elements[f.key].files[0];\n          if (f.required && !file) missing.push(f.label);\n          if (file) pending.push(readFile(file, 1600).then(function (v) { answers[f.key] = v; }));\n        } else {\n          answers[f.key] = el.elements[f.key].value;\n          if (f.required && !String(answers[f.key]).trim()) missing.push(f.label);\n        }\n      });\n      var msg = document.getElementById('formMsg');\n      if (missing.length) {\n        msg.innerHTML = '<div class=\"notice err\">Wajib diisi: ' + esc(missing.join(', ')) + '</div>';\n        msg.scrollIntoView({ behavior: 'smooth' });\n        return;\n      }\n      var btn = document.getElementById('submitBtn'), stageKey = stage.key;\n      btn.disabled = true; btn.textContent = 'Mengirim…';\n      Promise.all(pending).then(function () {\n        return call('apiSubmitReport', pub.batch.id, answers, stageKey);\n      }).then(function () {\n        msg.innerHTML = '<div class=\"notice ok\">' + esc(form.settings.successMessage) + '</div>';\n        // Keep name and date so the same santri can quickly send another report.\n        var keep = {};\n        ['student', 'date'].forEach(function (k) { if (el.elements[k]) keep[k] = el.elements[k].value; });\n        el.reset();\n        el.querySelectorAll('.file-preview').forEach(function (b) { b.innerHTML = ''; });\n        Object.keys(keep).forEach(function (k) { el.elements[k].value = keep[k]; });\n        delete dash[stageKey];\n        msg.scrollIntoView({ behavior: 'smooth' });\n      }).catch(function (err) {\n        msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>';\n        msg.scrollIntoView({ behavior: 'smooth' });\n      }).then(function () {\n        btn.disabled = false; btn.textContent = 'Kirim laporan';\n      });\n    });\n\n    function loadDashboard() {\n      var el = document.getElementById('dashboard');\n      if (!pub || !stage) return;\n      var key = stage.key;\n      if (dash[key]) { renderAnyDashboard(el, dash[key], dashState); return; }\n      el.innerHTML = '<div class=\"loading\">Memuat dashboard…</div>';\n      call('apiGetDashboard', pub.batch.id, key).then(function (d) {\n        dash[key] = d;\n        if (stage && stage.key === key) renderAnyDashboard(el, d, dashState);\n      }).catch(function (e) { el.innerHTML = '<div class=\"notice err\">' + esc(e.message) + '</div>'; });\n    }\n\n    loadPublic(INITIAL_BATCH).then(function () {\n      // Old links (?view=dashboard without a stage) meant Stage 1.\n      var key = INITIAL_STAGE || (INITIAL_VIEW === 'dashboard' ? 'stage1' : '');\n      if (pub && key && pub.forms[key]) openStage(key, INITIAL_VIEW);\n    });\n  </script>\n</body>\n</html>\n",
  "Setup": "<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"utf-8\">\n  <?!= include('Styles'); ?>\n</head>\n<body>\n  <header class=\"top\"><div><h1>Stage 1 - Akademi BTC</h1><div class=\"sub\">Setup pertama</div></div></header>\n  <main>\n    <section class=\"card\" style=\"max-width:560px;margin:24px auto\">\n      <? if (!isOwner) { ?>\n        <h2>Aplikasi belum siap</h2>\n        <p class=\"muted\">Aplikasi ini belum di-setup oleh developer. Silakan coba lagi nanti.</p>\n      <? } else { ?>\n        <h2>Setup aplikasi</h2>\n        <p class=\"muted\">Halaman ini hanya muncul sekali, untuk akun pemilik. Setelah disimpan, aplikasi membuat folder data, spreadsheet registry, dan batch pertama.</p>\n        <div id=\"msg\"></div>\n        <form id=\"setupForm\">\n          <label class=\"field\"><span class=\"lbl\">Folder Google Drive untuk data</span>\n            <span class=\"help\">Tempel link folder (drive.google.com/drive/folders/…). Kosongkan untuk membuat folder baru \"Akademi BTC - Stage 1\".</span>\n            <input id=\"rootFolder\" placeholder=\"https://drive.google.com/drive/folders/...\"></label>\n          <label class=\"field\"><span class=\"lbl\">Nama batch pertama</span><input id=\"batchName\" value=\"Batch 4\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Hari pertama Stage 1</span><input id=\"batchStart\" type=\"date\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Password Dev</span><span class=\"help\">Minimal 6 karakter. Dipakai untuk masuk ke halaman Dev.</span>\n            <input id=\"pw\" type=\"password\" autocomplete=\"new-password\" required></label>\n          <label class=\"field\"><span class=\"lbl\">Ulangi password</span><input id=\"pw2\" type=\"password\" autocomplete=\"new-password\" required></label>\n          <button class=\"btn primary\" type=\"submit\" id=\"go\">Simpan &amp; buat aplikasi</button>\n        </form>\n      <? } ?>\n    </section>\n  </main>\n  <div id=\"toast\"></div>\n  <?!= include('Shared'); ?>\n  <script>\n    var form = document.getElementById('setupForm');\n    if (form) {\n      document.getElementById('batchStart').value = new Date().toISOString().slice(0, 10);\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var msg = document.getElementById('msg'), btn = document.getElementById('go');\n        var pw = document.getElementById('pw').value;\n        if (pw.length < 6) { msg.innerHTML = '<div class=\"notice err\">Password minimal 6 karakter.</div>'; return; }\n        if (pw !== document.getElementById('pw2').value) { msg.innerHTML = '<div class=\"notice err\">Password tidak sama.</div>'; return; }\n        btn.disabled = true; btn.textContent = 'Menyiapkan…';\n        call('apiRunSetup', {\n          rootFolder: document.getElementById('rootFolder').value, password: pw,\n          firstBatchName: document.getElementById('batchName').value, firstBatchStart: document.getElementById('batchStart').value\n        }).then(function () {\n          form.classList.add('hidden');\n          return call('apiAppUrl').then(function (url) {\n            msg.innerHTML = '<div class=\"notice ok\">Setup selesai.</div><p><a class=\"btn primary\" target=\"_top\" href=\"' + esc(url) +\n              '?mode=dev\">Buka halaman Dev</a> <a class=\"btn\" target=\"_top\" href=\"' + esc(url) + '\">Buka halaman Guest</a></p>';\n          });\n        }).catch(function (err) {\n          msg.innerHTML = '<div class=\"notice err\">' + esc(err.message) + '</div>';\n          btn.disabled = false; btn.textContent = 'Simpan & buat aplikasi';\n        });\n      });\n    }\n  </script>\n</body>\n</html>\n",
  "Shared": "<script>\n  /** Promise wrapper around google.script.run. */\n  function call(fn) {\n    var args = Array.prototype.slice.call(arguments, 1);\n    return new Promise(function (resolve, reject) {\n      var r = google.script.run.withSuccessHandler(resolve).withFailureHandler(function (e) {\n        reject(e && e.message ? e : new Error(String(e)));\n      });\n      r[fn].apply(r, args);\n    });\n  }\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  }\n\n  /**\n   * Reads a file as { name, mimeType, data(base64) }. Photos are shrunk to `maxDim` px on the long side\n   * and re-encoded as JPEG so uploads stay small on phone connections; other files are sent as-is (max 10 MB).\n   */\n  function readFile(file, maxDim) {\n    var isPhoto = /^image\\/(jpeg|png|webp|heic|heif)$/i.test(file.type);\n    return new Promise(function (resolve, reject) {\n      if (!isPhoto && file.size > 10 * 1024 * 1024) return reject(new Error('File \"' + file.name + '\" lebih dari 10 MB.'));\n      var r = new FileReader();\n      r.onerror = function () { reject(new Error('Gagal membaca file \"' + file.name + '\".')); };\n      r.onload = function () {\n        var raw = { name: file.name, mimeType: file.type || 'application/octet-stream', data: String(r.result).split(',')[1] };\n        if (!isPhoto) return resolve(raw);\n        var img = new Image();\n        img.onerror = function () {\n          if (file.size > 10 * 1024 * 1024) reject(new Error('File \"' + file.name + '\" lebih dari 10 MB.'));\n          else resolve(raw); // format the browser cannot draw (e.g. HEIC on some devices): send original\n        };\n        img.onload = function () {\n          var scale = Math.min(1, maxDim / Math.max(img.width, img.height));\n          var c = document.createElement('canvas');\n          c.width = Math.round(img.width * scale);\n          c.height = Math.round(img.height * scale);\n          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);\n          resolve({ name: file.name.replace(/\\.[^.]+$/, '') + '.jpg', mimeType: 'image/jpeg', data: c.toDataURL('image/jpeg', 0.85).split(',')[1] });\n        };\n        img.src = r.result;\n      };\n      r.readAsDataURL(file);\n    });\n  }\n\n  function fmtPct(v) { return v == null ? '–' : (Math.round(v) + '%'); }\n  function fmtNum(v) { return v == null ? '–' : (Math.round(v * 10) / 10).toLocaleString('id-ID'); }\n\n  var toastTimer;\n  function toast(msg) {\n    var t = document.getElementById('toast');\n    t.textContent = msg;\n    t.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(function () { t.classList.remove('show'); }, 3000);\n  }\n\n  /**\n   * Tab bar: clicking a [data-tab] button shows the matching [data-panel]. Panels belong to the bar whose\n   * data-group matches theirs, so tab bars can be nested (no data-group = the page's main tabs).\n   */\n  function setTabs(root, onChange) {\n    var group = root.getAttribute('data-group') || '';\n    var buttons = root.querySelectorAll('[data-tab]');\n    buttons.forEach(function (b) {\n      b.addEventListener('click', function () {\n        buttons.forEach(function (x) { x.classList.toggle('active', x === b); });\n        document.querySelectorAll('[data-panel]').forEach(function (p) {\n          if ((p.getAttribute('data-group') || '') !== group) return;\n          p.classList.toggle('hidden', p.getAttribute('data-panel') !== b.getAttribute('data-tab'));\n        });\n        if (onChange) onChange(b.getAttribute('data-tab'));\n      });\n    });\n  }\n\n  function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }\n\n  /**\n   * Renders the dashboard into `el`. Shared by the Guest page and the Dev preview.\n   * state.selected: student id or '' for all.\n   */\n  var charts = {};\n  function renderDashboard(el, d, state) {\n    var cats = d.categories;\n    var sel = state.selected || '';\n    var students = d.students;\n    var selStudent = students.filter(function (s) { return s.id === sel; })[0] || null;\n    var focus = selStudent ? { totalDone: selStudent.totalDone, totalTarget: selStudent.totalTarget, pct: selStudent.pct,\n      done: selStudent.done, target: selStudent.target, ach: selStudent.ach } : d.totals;\n\n    var html = '';\n    if (d.notice) html += '<div class=\"notice info\">' + esc(d.notice) + '</div>';\n    html += '<div class=\"grid kpis\" style=\"margin-bottom:16px\">';\n    html += kpi('Hari berjalan', d.day + ' / ' + d.durationDays, 'Mulai ' + esc(d.startDate || '-'));\n    html += kpi(selStudent ? 'Unit selesai' : 'Total unit selesai', fmtNum(focus.totalDone), 'Target ' + fmtNum(focus.totalTarget));\n    html += kpi('Capaian', fmtPct(focus.pct), selStudent ? esc(selStudent.name) : 'Semua santri');\n    if (d.expectedToday != null) {\n      html += selStudent\n        ? kpi('Target milestone hari ini', fmtNum(d.expectedToday), statusPill(selStudent.status))\n        : kpi('Sesuai target', d.totals.onTrack + ' / ' + students.length, d.totals.behind + ' santri di bawah target hari ini (' + fmtNum(d.expectedToday) + ' unit)');\n    }\n    cats.forEach(function (c) {\n      html += kpi(esc(c.label), fmtNum(focus.done[c.key]) + ' / ' + fmtNum(focus.target[c.key]), fmtPct(focus.ach[c.key]));\n    });\n    html += '</div>';\n\n    html += '<div class=\"card\"><div class=\"chips\">';\n    html += '<button class=\"chip' + (sel ? '' : ' active') + '\" data-student=\"\">Semua</button>';\n    students.forEach(function (s) {\n      html += '<button class=\"chip' + (sel === s.id ? ' active' : '') + '\" data-student=\"' + esc(s.id) + '\">' +\n        esc(s.nickname || s.name.split(' ')[0]) + '</button>';\n    });\n    html += '</div>';\n    html += selStudent ? studentReportsHtml(selStudent) : studentTableHtml(students, cats);\n    html += '</div>';\n\n    html += '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(320px,1fr))\">';\n    html += '<div class=\"card\"><h2>Progres kumulatif ' + (selStudent ? '– ' + esc(selStudent.name) : '(rata-rata santri)') +\n      '</h2><div class=\"chart-box\"><canvas id=\"chartLine\"></canvas></div></div>';\n    if (!selStudent) html += '<div class=\"card\"><h2>Unit selesai per santri</h2><div class=\"chart-box\"><canvas id=\"chartBar\"></canvas></div></div>';\n    html += '</div>';\n\n    html += '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(320px,1fr))\">';\n    html += '<div class=\"card\"><h2>Milestone target</h2><div class=\"table-wrap\"><table><thead><tr><th>Hari ke</th><th class=\"num\">Jml Unit</th></tr></thead><tbody>';\n    d.milestones.forEach(function (m) {\n      html += '<tr' + (d.day >= m.day ? ' class=\"selected\"' : '') + '><td>' + m.day + '</td><td class=\"num\">' + fmtNum(m.units) + '</td></tr>';\n    });\n    if (!d.milestones.length) html += '<tr><td colspan=\"2\" class=\"muted\">Belum ada milestone.</td></tr>';\n    html += '</tbody></table></div></div>';\n    if (d.showRecent && !selStudent) {\n      var rec = d.recent.filter(function (r) { return !sel || r.studentId === sel; }).slice(0, 15);\n      html += '<div class=\"card\"><h2>Laporan terbaru</h2><div class=\"table-wrap\"><table><thead><tr><th>Tanggal</th><th>Nama</th><th>Perangkat</th><th class=\"num\">Unit</th></tr></thead><tbody>';\n      rec.forEach(function (r) {\n        html += '<tr><td>' + esc(r.date) + '</td><td>' + esc(r.studentName) + '</td><td>' + esc(r.category) + '</td><td class=\"num\">' + fmtNum(r.units) + '</td></tr>';\n      });\n      if (!rec.length) html += '<tr><td colspan=\"4\" class=\"muted\">Belum ada laporan.</td></tr>';\n      html += '</tbody></table></div></div>';\n    }\n    html += '</div>';\n    el.innerHTML = html;\n\n    el.querySelectorAll('[data-student]').forEach(function (b) {\n      b.addEventListener('click', function () {\n        state.selected = b.getAttribute('data-student');\n        renderDashboard(el, d, state);\n      });\n    });\n    drawCharts(d, selStudent);\n  }\n\n  // \"Semua\": one row per santri with done / target / achievement per device type.\n  function studentTableHtml(students, cats) {\n    var html = '<div class=\"table-wrap\"><table><thead><tr><th rowspan=\"2\">No.</th><th rowspan=\"2\">Nama</th>';\n    html += '<th class=\"group\" colspan=\"' + cats.length + '\">Done</th><th class=\"group\" colspan=\"' + cats.length + '\">Target</th>';\n    html += '<th class=\"group\" colspan=\"' + cats.length + '\">Achievement</th><th class=\"group\" colspan=\"3\">Akumulasi</th><th rowspan=\"2\">Status</th></tr><tr>';\n    for (var g = 0; g < 3; g++) cats.forEach(function (c) { html += '<th class=\"num\">' + esc(c.label) + '</th>'; });\n    html += '<th class=\"num\">Prog.</th><th class=\"num\">%</th><th></th></tr></thead><tbody>';\n    students.forEach(function (s, i) {\n      html += '<tr><td>' + (i + 1) + '</td><td>' + esc(s.name) + '</td>';\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtNum(s.done[c.key]) + '</td>'; });\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtNum(s.target[c.key]) + '</td>'; });\n      cats.forEach(function (c) { html += '<td class=\"num\">' + fmtPct(s.ach[c.key]) + '</td>'; });\n      html += '<td class=\"num\">' + fmtNum(s.totalDone) + '</td><td class=\"num\">' + fmtPct(s.pct) + '</td>';\n      html += '<td><div class=\"bar\"><i style=\"width:' + Math.min(100, s.pct || 0) + '%\"></i></div></td>';\n      html += '<td>' + statusPill(s.status) + '</td></tr>';\n    });\n    if (!students.length) html += '<tr><td colspan=\"' + (6 + cats.length * 3) + '\" class=\"muted\">Belum ada santri.</td></tr>';\n    return html + '</tbody></table></div>';\n  }\n\n  // One santri selected: every unit they reported through the form, newest first.\n  function studentReportsHtml(s) {\n    var reps = s.reports || [];\n    var html = '<h2>Unit yang dilaporkan – ' + esc(s.name) + ' <span class=\"muted\" style=\"font-weight:400\">(' + reps.length + ' laporan)</span></h2>';\n    html += '<div class=\"table-wrap\"><table><thead><tr><th>No.</th><th>Tanggal</th><th>Perangkat</th><th>Detail</th><th class=\"num\">Unit</th></tr></thead><tbody>';\n    reps.forEach(function (r, i) {\n      var det = (r.details || []).map(function (x) { return '<div><span class=\"muted\">' + esc(x.label) + ':</span> ' + esc(x.value) + '</div>'; }).join('');\n      html += '<tr><td>' + (reps.length - i) + '</td><td>' + esc(r.date) + '</td><td>' + esc(r.category) + '</td><td>' + (det || '<span class=\"muted\">–</span>') +\n        '</td><td class=\"num\">' + fmtNum(r.units) + '</td></tr>';\n    });\n    if (!reps.length) html += '<tr><td colspan=\"5\" class=\"muted\">Belum ada laporan dari santri ini.</td></tr>';\n    return html + '</tbody></table></div>';\n  }\n\n  /**\n   * Recap for stages without unit targets (Stage 0): report count per santri, answer tallies,\n   * and, when a santri is picked, only that santri's own reports.\n   */\n  function renderRecap(el, d, state) {\n    var sel = state.selected || '';\n    var students = d.students;\n    var selStudent = students.filter(function (s) { return s.id === sel; })[0] || null;\n    var html = '<div class=\"grid kpis\" style=\"margin-bottom:16px\">';\n    if (selStudent) {\n      html += kpi('Laporan', fmtNum(selStudent.count), esc(selStudent.name));\n      html += kpi('Terakhir lapor', esc(selStudent.last || '–'), '');\n    } else {\n      html += kpi('Total laporan', fmtNum(d.totals.reports), 'Semua santri');\n      html += kpi('Santri sudah lapor', d.totals.studentsReported + ' / ' + d.totals.students, '');\n    }\n    html += '</div>';\n\n    html += '<div class=\"card\"><div class=\"chips\">';\n    html += '<button class=\"chip' + (sel ? '' : ' active') + '\" data-student=\"\">Semua</button>';\n    students.forEach(function (s) {\n      html += '<button class=\"chip' + (sel === s.id ? ' active' : '') + '\" data-student=\"' + esc(s.id) + '\">' + esc(s.nickname || s.name.split(' ')[0]) + '</button>';\n    });\n    html += '</div>';\n    if (selStudent) {\n      var reps = selStudent.reports;\n      html += '<h2>Laporan – ' + esc(selStudent.name) + ' <span class=\"muted\" style=\"font-weight:400\">(' + reps.length + ' laporan)</span></h2>';\n      html += '<div class=\"table-wrap\"><table><thead><tr><th>No.</th><th>Tanggal</th><th>Detail</th></tr></thead><tbody>';\n      reps.forEach(function (r, i) {\n        var det = r.details.map(function (x) { return '<div><span class=\"muted\">' + esc(x.label) + ':</span> ' + esc(x.value) + '</div>'; }).join('');\n        html += '<tr><td>' + (reps.length - i) + '</td><td>' + esc(r.date) + '</td><td>' + (det || '<span class=\"muted\">–</span>') + '</td></tr>';\n      });\n      if (!reps.length) html += '<tr><td colspan=\"3\" class=\"muted\">Belum ada laporan dari santri ini.</td></tr>';\n    } else {\n      html += '<div class=\"table-wrap\"><table><thead><tr><th>No.</th><th>Nama</th><th class=\"num\">Jumlah laporan</th><th>Terakhir lapor</th></tr></thead><tbody>';\n      students.forEach(function (s, i) {\n        html += '<tr><td>' + (i + 1) + '</td><td>' + esc(s.name) + '</td><td class=\"num\">' + fmtNum(s.count) + '</td><td>' +\n          (s.last ? esc(s.last) : '<span class=\"pill behind\">Belum lapor</span>') + '</td></tr>';\n      });\n      if (!students.length) html += '<tr><td colspan=\"4\" class=\"muted\">Belum ada santri.</td></tr>';\n    }\n    html += '</tbody></table></div></div>';\n\n    if (!selStudent && d.tallies.length) {\n      html += '<div class=\"grid\" style=\"grid-template-columns:repeat(auto-fit,minmax(320px,1fr))\">';\n      d.tallies.forEach(function (t) {\n        var max = Math.max.apply(null, t.items.map(function (x) { return x.count; }).concat([1]));\n        html += '<div class=\"card\"><h2>' + esc(t.label) + '</h2><table><tbody>';\n        t.items.forEach(function (it) {\n          html += '<tr><td>' + esc(it.option) + '</td><td class=\"num\">' + fmtNum(it.count) + '</td>' +\n            '<td style=\"width:35%\"><div class=\"bar\"><i style=\"width:' + Math.round(100 * it.count / max) + '%\"></i></div></td></tr>';\n        });\n        html += '</tbody></table></div>';\n      });\n      html += '</div>';\n    }\n    el.innerHTML = html;\n    el.querySelectorAll('[data-student]').forEach(function (b) {\n      b.addEventListener('click', function () { state.selected = b.getAttribute('data-student'); renderRecap(el, d, state); });\n    });\n  }\n\n  /** Draws either dashboard kind returned by apiGetDashboard / apiDevGetDashboard. */\n  function renderAnyDashboard(el, d, state) {\n    if (d.kind === 'recap') renderRecap(el, d, state); else renderDashboard(el, d, state);\n  }\n\n  function kpi(label, value, hint) {\n    return '<div class=\"kpi\"><div class=\"label\">' + label + '</div><div class=\"value\">' + value + '</div><div class=\"hint\">' + (hint || '') + '</div></div>';\n  }\n\n  function statusPill(s) {\n    if (s === 'on-track') return '<span class=\"pill ok\">Sesuai target</span>';\n    if (s === 'behind') return '<span class=\"pill behind\">Di bawah target</span>';\n    return '<span class=\"pill none\">–</span>';\n  }\n\n  function drawCharts(d, selStudent) {\n    if (typeof Chart === 'undefined') return;\n    Object.keys(charts).forEach(function (k) { charts[k].destroy(); });\n    charts = {};\n    var accent = cssVar('--accent'), muted = cssVar('--muted'), border = cssVar('--border'), text = cssVar('--text');\n    Chart.defaults.color = muted;\n    Chart.defaults.borderColor = border;\n    var labels = [];\n    for (var i = 1; i <= d.seriesLen; i++) labels.push(i);\n    var actual;\n    if (selStudent) actual = selStudent.cumulative.slice();\n    else {\n      var n = d.students.length || 1;\n      actual = labels.map(function (_, idx) {\n        var sum = 0;\n        d.students.forEach(function (s) { sum += s.cumulative[idx] || 0; });\n        return Math.round(sum / n * 10) / 10;\n      });\n    }\n    // Do not draw actual progress into the future.\n    actual = actual.map(function (v, idx) { return idx < d.day ? v : null; });\n    charts.line = new Chart(document.getElementById('chartLine'), {\n      type: 'line',\n      data: { labels: labels, datasets: [\n        { label: 'Aktual', data: actual, borderColor: accent, backgroundColor: accent, pointRadius: 0, borderWidth: 2.5, spanGaps: true },\n        { label: 'Target milestone', data: d.plan, borderColor: muted, borderDash: [6, 4], pointRadius: 0, borderWidth: 1.5 }\n      ] },\n      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },\n        scales: { x: { title: { display: true, text: 'Hari ke' } }, y: { beginAtZero: true, title: { display: true, text: 'Unit' } } },\n        plugins: { legend: { labels: { color: text } } } }\n    });\n    var palette = ['#0f6e5a', '#3b82c4', '#c27c0e', '#8e5bd1', '#c2410c', '#64748b'];\n    if (!document.getElementById('chartBar')) return;\n    charts.bar = new Chart(document.getElementById('chartBar'), {\n      type: 'bar',\n      data: { labels: d.students.map(function (s) { return s.nickname || s.name.split(' ')[0]; }),\n        datasets: d.categories.map(function (c, i) {\n          return { label: c.label, data: d.students.map(function (s) { return s.done[c.key]; }), backgroundColor: palette[i % palette.length], stack: 'u' };\n        }) },\n      options: { maintainAspectRatio: false, indexAxis: d.students.length > 10 ? 'y' : 'x',\n        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },\n        plugins: { legend: { labels: { color: text } } } }\n    });\n  }\n</script>\n",
  "Styles": "<style>\n  :root {\n    --bg: #f5f6f8; --surface: #ffffff; --surface-2: #eef1f5; --text: #1b2330; --muted: #5f6b7a;\n    --border: #d9dee6; --accent: #0f6e5a; --accent-2: #e6f3ef; --danger: #b42318; --danger-bg: #fdecea;\n    --warn: #9a6700; --warn-bg: #fff4d6; --ok: #137333; --ok-bg: #e6f4ea; --shadow: 0 1px 2px rgba(16,24,40,.06);\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #12161c; --surface: #1a2028; --surface-2: #222a35; --text: #e6eaf0; --muted: #9aa5b4;\n      --border: #2e3846; --accent: #4cc3a3; --accent-2: #173a32; --danger: #ff8a80; --danger-bg: #3a1d1b;\n      --warn: #f2c14e; --warn-bg: #3a2f12; --ok: #7bd88f; --ok-bg: #173322; --shadow: none;\n    }\n  }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--text);\n    font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n  a { color: var(--accent); }\n  header.top { background: var(--surface); border-bottom: 1px solid var(--border); padding: 12px 16px;\n    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }\n  header.top h1 { font-size: 18px; margin: 0; }\n  header.top .sub { color: var(--muted); font-size: 13px; }\n  main { max-width: 1200px; margin: 0 auto; padding: 16px; }\n  .tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border); margin-bottom: 16px; }\n  .tabs button { background: none; border: 0; border-bottom: 2px solid transparent; padding: 10px 14px;\n    color: var(--muted); font: inherit; cursor: pointer; }\n  .tabs button.active { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }\n  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px;\n    box-shadow: var(--shadow); margin-bottom: 16px; }\n  .card h2 { font-size: 16px; margin: 0 0 12px; }\n  .card h3 { font-size: 14px; margin: 16px 0 8px; color: var(--muted); text-transform: uppercas